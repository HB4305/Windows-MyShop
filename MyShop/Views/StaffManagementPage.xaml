<Page x:Class="MyShop.Views.StaffManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:MyShop.Controls"
      xmlns:conv="using:MyShop.Converters"
      xmlns:m="using:MyShop.Models"
      xmlns:repo="using:MyShop.Repositories"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Page.Resources>
    <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    <SolidColorBrush x:Key="AppPurpleBrush" Color="#8B52FF"/>
    <SolidColorBrush x:Key="PurpleLightBrush" Color="#8B52FF" Opacity="0.12"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>

    <Style x:Key="PanelBorder" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
      <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="20"/>
    </Style>

    <!-- Pagination Button Styles -->
    <Style x:Key="PageBtn" TargetType="Button">
      <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
    </Style>

    <Style x:Key="PageBtnActive" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AppPurpleBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </Page.Resources>

  <Grid Padding="24,20">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="NarrowState">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0"/>
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="ToolbarGrid.ColumnDefinitions[1].Width" Value="0"/>
            <Setter Target="AddButton.(Grid.Row)" Value="1"/>
            <Setter Target="AddButton.(Grid.Column)" Value="0"/>
            <Setter Target="AddButton.Margin" Value="0,12,0,0"/>
            <Setter Target="AddButton.HorizontalAlignment" Value="Stretch"/>
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="WideState">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1100"/>
          </VisualState.StateTriggers>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/> <!-- Header -->
      <RowDefinition Height="Auto"/> <!-- Message -->
      <RowDefinition Height="Auto"/> <!-- Toolbar (Search/Add) -->
      <RowDefinition Height="Auto"/> <!-- Stats -->
      <RowDefinition Height="*"/>    <!-- List (Scrollable) -->
      <RowDefinition Height="Auto"/> <!-- Pagination -->
    </Grid.RowDefinitions>

    <!-- Header -->
    <controls:AppPageHeader Grid.Row="0"
                            Margin="0,0,0,14"
                            Title="Staff Management"
                            Subtitle="Manage sales staff accounts and permissions."/>

    <!-- Status Message -->
    <Border Grid.Row="1"
            Style="{StaticResource PanelBorder}"
            Padding="16"
            Margin="0,0,0,16"
            Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
      <TextBlock Text="{Binding StatusMessage}"
                 TextWrapping="Wrap"
                 Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                 FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
    </Border>

    <!-- Stats Cards synchronized styling -->
    <Grid x:Name="StatsGrid" Grid.Row="3" ColumnSpacing="14" Margin="0,0,0,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition x:Name="KpiSpacer1" Width="*"/>
        <ColumnDefinition x:Name="KpiSpacer2" Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border x:Name="Card1" Style="{StaticResource PanelBorder}" Padding="16">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE716;" Foreground="{StaticResource AppPurpleBrush}" FontSize="16"/>
            <TextBlock Text="Total Managed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
          </StackPanel>
          <TextBlock Text="{Binding TotalStaffCount}" FontSize="24" FontWeight="Bold" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
        </StackPanel>
      </Border>

      <Border x:Name="Card2" Grid.Column="1" Style="{StaticResource PanelBorder}" Padding="16">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE8D2;" Foreground="{StaticResource SuccessBrush}" FontSize="16"/>
            <TextBlock Text="System Role" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
          </StackPanel>
          <TextBlock Text="OWNER" FontSize="24" FontWeight="Bold" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
        </StackPanel>
      </Border>

      <Border x:Name="Card3" Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="16">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE77B;" Foreground="{StaticResource WarningBrush}" FontSize="16"/>
            <TextBlock Text="Sale Staff" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
          </StackPanel>
          <TextBlock Text="{Binding SaleCount}" FontSize="24" FontWeight="Bold" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Toolbar synchronized -->
    <Grid x:Name="ToolbarGrid" Grid.Row="2" ColumnSpacing="14" RowSpacing="12" Margin="0,0,0,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Standardized Premium Search Bar (Matching Report Design) -->
      <Border x:Name="SearchWrapper"
              Grid.Row="0" Grid.Column="0"
              Background="{ThemeResource ControlFillColorDefaultBrush}"
              BorderThickness="1"
              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
              CornerRadius="24"
              Height="48"
              VerticalAlignment="Center">
          <AutoSuggestBox x:Name="SearchBox"
                          Style="{StaticResource ModernSearchAutoSuggestBoxStyle}"
                          PlaceholderText="Search staff by name or phone..."
                          Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          QuerySubmitted="OnSearchQuerySubmitted"
                          QueryIcon="Find"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="16,0,12,0"
                          VerticalAlignment="Stretch"
                          VerticalContentAlignment="Center"
                          GotFocus="SearchBox_GotFocus"
                          LostFocus="SearchBox_LostFocus"
                          FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans">
              <AutoSuggestBox.Resources>
                  <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                  <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                  <!-- Style the internal search button -->
                  <Style TargetType="Button" x:Key="AutoSuggestBoxQueryButtonStyle">
                      <Setter Property="Foreground" Value="{StaticResource AppPurpleBrush}"/>
                      <Setter Property="Background" Value="Transparent"/>
                      <Setter Property="BorderThickness" Value="0"/>
                  </Style>
                  <!-- Targeted style to hide the clear button -->
                  <Style TargetType="Button" x:Key="AutoSuggestBoxDeleteButtonStyle">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Setter Property="Width" Value="0"/>
                  </Style>
              </AutoSuggestBox.Resources>
          </AutoSuggestBox>
      </Border>

      <Button x:Name="AddButton" Grid.Row="0" Grid.Column="1" Click="AddStaff_Click" Background="{StaticResource AppPurpleBrush}" Foreground="White" 
              CornerRadius="24" Padding="16,10" Height="48" Style="{StaticResource ColorPreservingButtonStyle}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE710;" FontSize="15" Foreground="White"/>
          <TextBlock Text="Add Staff" VerticalAlignment="Center" FontWeight="SemiBold" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
        </StackPanel>
      </Button>
    </Grid>

    <!-- List Content synchronized with CustomerPage -->
    <Grid Grid.Row="4">
      <Border Style="{StaticResource PanelBorder}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
          <Grid MinWidth="800">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Table Header -->
            <Border Grid.Row="0" Background="{ThemeResource ControlFillColorDefaultBrush}"
                    CornerRadius="20" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1" Padding="16,14">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3*"/>
                  <ColumnDefinition Width="1.2*"/>
                  <ColumnDefinition Width="1.6*"/>
                  <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="EMAIL ADDRESS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                <TextBlock Grid.Column="1" Text="ROLE" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                <TextBlock Grid.Column="2" Text="CREATED AT" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                <TextBlock Grid.Column="3" Text="ACTIONS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
              </Grid>
            </Border>

            <!-- Table Body -->
            <Grid Grid.Row="1">
              <!-- Loading -->
              <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <controls:StaffSkeletonRow/>
                <controls:StaffSkeletonRow/>
                <controls:StaffSkeletonRow/>
                <controls:StaffSkeletonRow/>
                <controls:StaffSkeletonRow/>
              </StackPanel>

              <ListView ItemsSource="{Binding FilteredStaffMembers}" SelectionMode="None" Padding="0,4"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Enabled"
                        Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="16,0"/>
                    <Setter Property="MinHeight" Value="56"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="repo:UserRecord">
                    <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="3*"/>
                          <ColumnDefinition Width="1.2*"/>
                          <ColumnDefinition Width="1.6*"/>
                          <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Email}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                        <TextBlock Grid.Column="1" Text="SALE" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind CreatedAtDisplay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                          <Button Click="EditStaff_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Padding="4" Style="{StaticResource ColorPreservingButtonStyle}">
                            <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                          </Button>
                          <Button Click="DeleteStaff_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Padding="4" Style="{StaticResource ColorPreservingButtonStyle}">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#DC2626"/>
                          </Button>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </Grid>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Pagination -->
    <Border Grid.Row="5" BorderThickness="0"
            Margin="-24,0,-24,-20" Padding="24,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
            <TextBlock Text="Showing" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"
                       FontFamily="{StaticResource AppDefaultFontFamily}"/>
            <TextBlock Text="{Binding DisplayFrom}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13"
                       FontFamily="{StaticResource AppDefaultFontFamily}"/>
            <TextBlock Text="to" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"
                       FontFamily="{StaticResource AppDefaultFontFamily}"/>
            <TextBlock Text="{Binding DisplayTo}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13"
                       FontFamily="{StaticResource AppDefaultFontFamily}"/>
            <TextBlock Text="of" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"
                       FontFamily="{StaticResource AppDefaultFontFamily}"/>
            <TextBlock Text="{Binding TotalItems}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13"
                       FontFamily="{StaticResource AppDefaultFontFamily}"/>
            <TextBlock Text="staff members" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"
                       FontFamily="{StaticResource AppDefaultFontFamily}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" x:Name="StaffPaginationPanel"/>
        </Grid>
      </Border>


    <!-- Empty State -->
    <StackPanel Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibilityConverter}}">
      <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource PurpleLightBrush}">
        <FontIcon Glyph="&#xE716;" FontSize="28" Foreground="{StaticResource AppPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <TextBlock Text="No staff members found" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
    </StackPanel>
  </Grid>
</Page>
