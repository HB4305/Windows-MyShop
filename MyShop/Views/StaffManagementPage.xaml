<Page x:Class="MyShop.Views.StaffManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:MyShop.Converters"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Page.Resources>
    <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#8B52FF"/>
    <SolidColorBrush x:Key="PurpleLightBrush" Color="#8B52FF" Opacity="0.12"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>

    <Style x:Key="PanelBorder" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
      <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
    </Style>
  </Page.Resources>

  <Grid Padding="24,20" RowSpacing="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Spacing="2">
        <TextBlock Text="Staff Management"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="{ThemeResource TextFillColorPrimary}"/>
        <TextBlock Text="OWNER is the admin account. This screen only manages SALE staff accounts."
                   FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondary}"/>
      </StackPanel>

      <Button Grid.Column="1"
              Click="AddStaff_Click"
              Background="{StaticResource PurpleBrush}"
              Foreground="White"
              BorderThickness="0"
              Padding="16,10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE710;" FontSize="14"/>
          <TextBlock Text="Add Staff"/>
        </StackPanel>
      </Button>
    </Grid>

    <Border Grid.Row="1"
            Style="{StaticResource PanelBorder}"
            Padding="16"
            Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
      <TextBlock Text="{Binding StatusMessage}"
                 TextWrapping="Wrap"
                 Foreground="{ThemeResource TextFillColorPrimary}"/>
    </Border>

    <Grid Grid.Row="2" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource PanelBorder}" Padding="16">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE716;" Foreground="{StaticResource PurpleBrush}" FontSize="16"/>
            <TextBlock Text="Managed Staff" Foreground="{ThemeResource TextFillColorSecondary}"/>
          </StackPanel>
          <TextBlock Text="{Binding TotalStaff}" FontSize="24" FontWeight="Bold"/>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Padding="16">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE8D2;" Foreground="{StaticResource SuccessBrush}" FontSize="16"/>
            <TextBlock Text="Admin Role" Foreground="{ThemeResource TextFillColorSecondary}"/>
          </StackPanel>
          <TextBlock Text="OWNER" FontSize="24" FontWeight="Bold"/>
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="16">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE77B;" Foreground="{StaticResource WarningBrush}" FontSize="16"/>
            <TextBlock Text="SALE Accounts" Foreground="{ThemeResource TextFillColorSecondary}"/>
          </StackPanel>
          <TextBlock Text="{Binding SaleCount}" FontSize="24" FontWeight="Bold"/>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="18">
      <Grid RowSpacing="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="Search by email or role..."
                   MinHeight="42"/>

          <ProgressRing Grid.Column="2"
                        Width="28"
                        Height="28"
                        IsActive="{Binding IsLoading}"
                        VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1">
          <ListView ItemsSource="{Binding FilteredStaffMembers}"
                    SelectionMode="None">
            <ListView.Header>
              <Grid Padding="16,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3*"/>
                  <ColumnDefinition Width="1.2*"/>
                  <ColumnDefinition Width="1.6*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Email" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="Role" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="Created At" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="3" Text="Actions" FontWeight="SemiBold" HorizontalAlignment="Right"/>
              </Grid>
            </ListView.Header>

            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Padding="16,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <TextBlock Text="{Binding Email}"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="SALE"
                               VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2"
                             Text="{Binding CreatedAtDisplay}"
                             VerticalAlignment="Center"/>

                  <StackPanel Grid.Column="3"
                              Orientation="Horizontal"
                              Spacing="8"
                              HorizontalAlignment="Right">
                    <Button Click="EditStaff_Click"
                            Tag="{Binding}"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Edit staff">
                      <FontIcon Glyph="&#xE70F;" Foreground="{StaticResource PurpleBrush}"/>
                    </Button>
                    <Button Click="DeleteStaff_Click"
                            Tag="{Binding}"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Delete staff">
                      <FontIcon Glyph="&#xE74D;"/>
                    </Button>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="10"
                      Visibility="{Binding FilteredStaffMembers.Count, Converter={StaticResource CountToVisibilityConverter}}">
            <Border Width="60" Height="60" CornerRadius="30" Background="{StaticResource PurpleLightBrush}">
              <FontIcon Glyph="&#xE716;"
                        FontSize="28"
                        Foreground="{StaticResource PurpleBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="No staff found"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondary}"/>
            <TextBlock Text="Try a different search term or create a new staff account."
                       FontSize="13"
                       Foreground="{ThemeResource TextFillColorTertiary}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="260"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Page>
