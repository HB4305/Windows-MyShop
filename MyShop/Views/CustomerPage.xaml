<Page x:Class="MyShop.Views.CustomerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:MyShop.Models"
      xmlns:controls="using:MyShop.Controls"
      xmlns:conv="using:MyShop.Converters"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <SolidColorBrush x:Key="AppPurpleBrush" Color="#8B52FF"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

        <!-- Pagination Button Styles -->
        <Style x:Key="PageBtn" TargetType="Button">
          <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
          <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
          <Setter Property="FontSize" Value="13"/>
          <Setter Property="MinWidth" Value="32"/>
          <Setter Property="Height" Value="32"/>
          <Setter Property="Padding" Value="8,4"/>
          <Setter Property="CornerRadius" Value="6"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
        </Style>

        <Style x:Key="PageBtnActive" TargetType="Button">
          <Setter Property="Background" Value="{StaticResource AppPurpleBrush}"/>
          <Setter Property="Foreground" Value="White"/>
          <Setter Property="FontSize" Value="13"/>
          <Setter Property="MinWidth" Value="32"/>
          <Setter Property="Height" Value="32"/>
          <Setter Property="Padding" Value="8,4"/>
          <Setter Property="CornerRadius" Value="6"/>
          <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Page.Resources>

    <Grid Margin="24,20">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderGrid.ColumnDefinitions[1].Width" Value="0"/>
                        <Setter Target="AddCustomerButton.(Grid.Row)" Value="1"/>
                        <Setter Target="AddCustomerButton.(Grid.Column)" Value="0"/>
                        <Setter Target="AddCustomerButton.Margin" Value="0,12,0,0"/>
                        <Setter Target="AddCustomerButton.HorizontalAlignment" Value="Stretch"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100"/>
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Page Header -->
            <RowDefinition Height="Auto"/> <!-- Search & Add -->
            <RowDefinition Height="Auto"/> <!-- Separator -->
            <RowDefinition Height="*"/>    <!-- Table (Scrollable) -->
            <RowDefinition Height="Auto"/> <!-- Pagination -->
        </Grid.RowDefinitions>

        <controls:AppPageHeader Grid.Row="0"
                                Title="Customer Management"
                                Subtitle="Manage customer profiles and purchase history."
                                Margin="0,0,0,14"/>

        <!-- Header & Search -->
        <Grid x:Name="HeaderGrid" Grid.Row="1" ColumnSpacing="14" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Standardized Premium Search Bar (Matching Report Design) -->
            <Grid Grid.Column="0" VerticalAlignment="Center">
                <AutoSuggestBox x:Name="SearchBox"
                                PlaceholderText="Search customers..."
                                Text="{Binding SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                QuerySubmitted="OnSearchQuerySubmitted"
                                QueryIcon="Find"
                                CornerRadius="24"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                Padding="16,12,12,12"
                                Height="48"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans">
                    <AutoSuggestBox.Resources>
                        <!-- Style the internal search button -->
                        <Style TargetType="Button" x:Key="AutoSuggestBoxQueryButtonStyle">
                            <Setter Property="Foreground" Value="{StaticResource AppPurpleBrush}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                        <!-- Targeted style to hide the clear button -->
                        <Style TargetType="Button" x:Key="AutoSuggestBoxDeleteButtonStyle">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Width" Value="0"/>
                        </Style>
                    </AutoSuggestBox.Resources>
                </AutoSuggestBox>
            </Grid>

            <Button x:Name="AddCustomerButton"
                    Grid.Column="1"
                    Background="{StaticResource AppPurpleBrush}"
                    Foreground="White"
                    CornerRadius="24"
                    Padding="16,10"
                    Height="48"
                    Click="OnAddCustomerClick"
                  Style="{StaticResource ColorPreservingButtonStyle}"
                  Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="15" Foreground="White"/>
                    <TextBlock Text="New Customer" VerticalAlignment="Center" FontWeight="SemiBold" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                </StackPanel>
            </Button>
        </Grid>



        <!-- Table -->
        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
            <Grid MinWidth="900">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Table Header (Synced with Staff) -->
                <Border Grid.Row="0" Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="20"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="NAME" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                        <TextBlock Grid.Column="1" Text="PHONE" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                        <TextBlock Grid.Column="2" Text="ADDRESS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                        <TextBlock Grid.Column="3" Text="TOTAL SPENT" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                        <TextBlock Grid.Column="4" Text="ORDERS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                        <TextBlock Grid.Column="5" Text="ACTIONS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibilityConverter}}"
                                   FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                    </Grid>
                </Border>

                <!-- Table Body -->
                <Grid Grid.Row="1">
                    <ListView ItemsSource="{Binding Customers}"
                              IsItemClickEnabled="True"
                              ItemClick="OnCustomerClick"
                              Padding="0,4,0,8"
                              SelectionMode="None"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollMode="Enabled"
                              Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="16,0"/>
                                <Setter Property="MinHeight" Value="56"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="m:Customer">
                                <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="150"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>

                                        <TextBlock Grid.Column="1" Text="{x:Bind Phone}" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>

                                        <TextBlock Grid.Column="2" Text="{x:Bind Address}" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>

                                        <TextBlock Grid.Column="3" Text="{x:Bind TotalSpent, Converter={StaticResource CurrencyFormatter}}"
                                                   VerticalAlignment="Center" Foreground="{StaticResource AppPurpleBrush}" FontWeight="SemiBold" FontSize="13" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>

                                        <TextBlock Grid.Column="4" Text="{x:Bind OrderCount}" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" HorizontalAlignment="Left" Margin="10,0,0,0" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>

                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                                                    Visibility="{Binding DataContext.IsOwner, ElementName=SearchBox, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Button Background="Transparent" BorderThickness="0" Padding="4"
                                                    Click="OnEditCustomerClick" ToolTipService.ToolTip="Edit"
                  Style="{StaticResource ColorPreservingButtonStyle}">
                                                <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Button>
                                            <Button Background="Transparent" BorderThickness="0" Padding="4"
                                                    Click="OnDeleteCustomerClick" ToolTipService.ToolTip="Delete"
                  Style="{StaticResource ColorPreservingButtonStyle}">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#DC2626"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Skeleton loading state -->
                    <ItemsControl Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.Items>
                            <controls:CustomerSkeletonRow/>
                            <controls:CustomerSkeletonRow/>
                            <controls:CustomerSkeletonRow/>
                            <controls:CustomerSkeletonRow/>
                            <controls:CustomerSkeletonRow/>
                            <controls:CustomerSkeletonRow/>
                            <controls:CustomerSkeletonRow/>
                            <controls:CustomerSkeletonRow/>
                        </ItemsControl.Items>
                    </ItemsControl>
                </Grid>
            </Grid>
            </ScrollViewer>
        </Border>

        <!-- Table Footer: Pagination (Docked to bottom) -->
        <Border Grid.Row="4" 
                BorderThickness="0"
                Margin="-24,0,-24,-20" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Spacing="4">
                    <TextBlock Text="Showing" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                    <TextBlock Text="{Binding DisplayFrom}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                    <TextBlock Text="to" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                    <TextBlock Text="{Binding DisplayTo}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                    <TextBlock Text="of" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                    <TextBlock Text="{Binding TotalItems}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                    <TextBlock Text="customers" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            HorizontalAlignment="Right"
                            x:Name="CustomerPaginationPanel"/>
            </Grid>
        </Border>

        <!-- Error Message -->
        <TextBlock Grid.Row="4"
                   Margin="0,12,0,0"
                   Text="{Binding ErrorMessage}"
                   Foreground="#DC2626"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
        <!-- Global Loading Overlay (for dialog opening) -->
        <Grid x:Name="GlobalLoadingOverlay"
              Grid.Row="0" Grid.RowSpan="7"
              Background="#66000000"
              Visibility="Collapsed"
              Canvas.ZIndex="100">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="32,24" CornerRadius="20"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <ProgressBar IsIndeterminate="True" Width="120" Foreground="{StaticResource AppPurpleBrush}"/>
                    <TextBlock Text="Opening..." FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
