<Page x:Class="MyShop.Views.SuppliersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:MyShop.Controls"
      xmlns:conv="using:MyShop.Converters"
      xmlns:m="using:MyShop.Models"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Page.Resources>
    <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    <conv:CurrencyFormatter x:Key="CurrencyFormatter"/>
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    <SolidColorBrush x:Key="AppPurpleBrush" Color="#8B52FF"/>

    <!-- Pagination Button Styles -->
    <Style x:Key="PageBtn" TargetType="Button">
      <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
    </Style>

    <Style x:Key="PageBtnActive" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AppAccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </Page.Resources>

  <Grid Padding="24,20" VerticalAlignment="Stretch">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="NarrowState">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0"/>
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="SuppliersToolbarGrid.ColumnDefinitions[1].Width" Value="0"/>
            <Setter Target="AddSupplierButton.(Grid.Row)" Value="1"/>
            <Setter Target="AddSupplierButton.(Grid.Column)" Value="0"/>
            <Setter Target="AddSupplierButton.Margin" Value="0,12,0,0"/>
            <Setter Target="AddSupplierButton.HorizontalAlignment" Value="Stretch"/>

            <Setter Target="OrdersToolbarGrid.ColumnDefinitions[1].Width" Value="0"/>
            <Setter Target="AddOrderButton.(Grid.Row)" Value="1"/>
            <Setter Target="AddOrderButton.(Grid.Column)" Value="0"/>
            <Setter Target="AddOrderButton.Margin" Value="0,12,0,0"/>
            <Setter Target="AddOrderButton.HorizontalAlignment" Value="Stretch"/>
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="WideState">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="900"/>
          </VisualState.StateTriggers>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <controls:AppPageHeader Grid.Row="0"
                            Margin="0,0,0,14"
                            Title="Suppliers Management"
                            Subtitle="Manage your suppliers and track supply order history."/>

    <!-- Tabs -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,20">
      <Button x:Name="TabSuppliers" Click="TabSuppliers_Click" 
              Padding="20,10" CornerRadius="20"
              Background="{StaticResource AppPurpleBrush}" Foreground="White"
              Style="{StaticResource ColorPreservingButtonStyle}">
          <TextBlock Text="Suppliers" FontWeight="SemiBold" FontFamily="{StaticResource AppDefaultFontFamily}"/>
      </Button>
      <Button x:Name="TabSupplyOrders" Click="TabSupplyOrders_Click" 
              Padding="20,10" CornerRadius="20"
              Background="Transparent" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
              Style="{StaticResource ColorPreservingButtonStyle}">
          <TextBlock Text="Supply History" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="{StaticResource AppDefaultFontFamily}"/>
      </Button>
    </StackPanel>

    <!-- Suppliers Tab Content -->
    <Grid x:Name="SuppliersGrid" Grid.Row="2" Grid.RowSpan="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid x:Name="SuppliersToolbarGrid" Grid.Row="0" ColumnSpacing="14" Margin="0,0,0,20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Standardized Premium Search Bar (Matching Report Design) -->
          <Grid Grid.Column="0" VerticalAlignment="Center">
              <AutoSuggestBox x:Name="SearchBox"
                              PlaceholderText="Search suppliers..."
                              Text="{Binding SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              QuerySubmitted="OnSearchQuerySubmitted"
                              QueryIcon="Find"
                              CornerRadius="24"
                              Background="{ThemeResource ControlFillColorDefaultBrush}"
                              BorderThickness="1"
                              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                              Padding="16,12,12,12"
                              Height="48"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              FontFamily="{StaticResource AppDefaultFontFamily}">
                  <AutoSuggestBox.Resources>
                      <!-- Style the internal search button -->
                      <Style TargetType="Button" x:Key="AutoSuggestBoxQueryButtonStyle">
                          <Setter Property="Foreground" Value="{StaticResource AppPurpleBrush}"/>
                          <Setter Property="Background" Value="Transparent"/>
                          <Setter Property="BorderThickness" Value="0"/>
                      </Style>
                      <!-- Targeted style to hide the clear button -->
                      <Style TargetType="Button" x:Key="AutoSuggestBoxDeleteButtonStyle">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Setter Property="Width" Value="0"/>
                      </Style>
                  </AutoSuggestBox.Resources>
              </AutoSuggestBox>
          </Grid>

          <Button x:Name="AddSupplierButton" Grid.Column="1" Click="AddSupplier_Click" Background="{StaticResource AppPurpleBrush}" Foreground="White" 
                  CornerRadius="20" Padding="16,10" MinHeight="48" Style="{StaticResource ColorPreservingButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE710;" FontSize="15" Foreground="White"/>
              <TextBlock Text="Add Supplier" VerticalAlignment="Center" FontWeight="SemiBold" FontFamily="{StaticResource AppDefaultFontFamily}"/>
            </StackPanel>
          </Button>
        </Grid>

        <!-- Table -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
    
                <!-- Table Header -->
                <Border Grid.Row="0" Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="20" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1" Padding="16,14">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="2*"/>
                      <ColumnDefinition Width="1.5*"/>
                      <ColumnDefinition Width="1.5*"/>
                      <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SUPPLIER NAME" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="{StaticResource AppDefaultFontFamily}"/>
                    <TextBlock Grid.Column="1" Text="CONTACT PHONE" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="{StaticResource AppDefaultFontFamily}"/>
                    <TextBlock Grid.Column="2" Text="TYPE" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="{StaticResource AppDefaultFontFamily}"/>
                    <TextBlock Grid.Column="3" Text="ACTIONS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" FontFamily="{StaticResource AppDefaultFontFamily}"/>
                  </Grid>
                </Border>
    
                <!-- Loading State -->
                <StackPanel Grid.Row="1" Visibility="{Binding IsLoadingSuppliers, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:SupplierSkeletonRow/>
                    <controls:SupplierSkeletonRow/>
                    <controls:SupplierSkeletonRow/>
                    <controls:SupplierSkeletonRow/>
                    <controls:SupplierSkeletonRow/>
                </StackPanel>
  
                <!-- Table Body -->
                <ListView Grid.Row="1" ItemsSource="{Binding Suppliers}" SelectionMode="None" Padding="0,4"
                          Visibility="{Binding IsLoadingSuppliers, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                  <ListView.ItemContainerStyle>
                      <Style TargetType="ListViewItem">
                          <Setter Property="Padding" Value="16,0"/>
                          <Setter Property="MinHeight" Value="56"/>
                          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      </Style>
                  </ListView.ItemContainerStyle>
                  <ListView.ItemTemplate>
                    <DataTemplate x:DataType="m:Supplier">
                      <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                        <Grid ColumnSpacing="12">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="100"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" FontFamily="{StaticResource AppDefaultFontFamily}"/>
                          <TextBlock Grid.Column="1" Text="{x:Bind ContactPhone}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="{StaticResource AppDefaultFontFamily}"/>
                          <TextBlock Grid.Column="2" Text="{x:Bind SupplierType}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="{StaticResource AppDefaultFontFamily}"/>
                          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button Click="EditSupplier_Click" Background="Transparent" BorderThickness="0" Padding="4" Style="{StaticResource ColorPreservingButtonStyle}">
                              <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                            <Button Command="{Binding DataContext.DeleteSupplierCommand, ElementName=SuppliersGrid}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="4" Style="{StaticResource ColorPreservingButtonStyle}">
                              <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#DC2626"/>
                            </Button>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
            </Grid>
          </Border>
    
          <!-- Table Footer -->
          <Border Grid.Row="2" 
                  BorderThickness="0"
                  Margin="-20,0,-20,-20" Padding="24,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Spacing="4">
                <TextBlock Text="Showing" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="{StaticResource AppDefaultFontFamily}"/>
                <TextBlock Text="{Binding SupplierDisplayFrom}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" FontFamily="{StaticResource AppDefaultFontFamily}"/>
                <TextBlock Text="to" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="{StaticResource AppDefaultFontFamily}"/>
                <TextBlock Text="{Binding SupplierDisplayTo}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" FontFamily="{StaticResource AppDefaultFontFamily}"/>
                <TextBlock Text="of" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="{StaticResource AppDefaultFontFamily}"/>
                <TextBlock Text="{Binding SupplierTotalItems}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" FontFamily="{StaticResource AppDefaultFontFamily}"/>
                <TextBlock Text="suppliers" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="{StaticResource AppDefaultFontFamily}"/>
              </StackPanel>
    
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="4"
                          HorizontalAlignment="Right"
                          x:Name="SupplierPaginationPanel"/>
            </Grid>
          </Border>
    </Grid>

    <!-- Supply History Tab Content -->
    <Grid x:Name="SupplyOrdersGrid" Grid.Row="2" Grid.RowSpan="2" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
  
        <!-- Toolbar -->
        <Grid x:Name="OrdersToolbarGrid" Grid.Row="0" ColumnSpacing="14" Margin="0,0,0,20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Standardized Premium Search Bar (Matching Report Design) -->
          <Grid Grid.Column="0" VerticalAlignment="Center">
              <AutoSuggestBox x:Name="OrderSearchBox"
                              PlaceholderText="Search orders by ID or supplier..."
                              Text="{Binding SearchOrderKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              QuerySubmitted="OnOrderSearchQuerySubmitted"
                              QueryIcon="Find"
                              CornerRadius="24"
                              Background="{ThemeResource ControlFillColorDefaultBrush}"
                              BorderThickness="1"
                              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                              Padding="16,12,12,12"
                              Height="48"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              FontFamily="{StaticResource AppDefaultFontFamily}">
                  <AutoSuggestBox.Resources>
                      <!-- Style the internal search button -->
                      <Style TargetType="Button" x:Key="AutoSuggestBoxQueryButtonStyle">
                          <Setter Property="Foreground" Value="{StaticResource AppPurpleBrush}"/>
                          <Setter Property="Background" Value="Transparent"/>
                          <Setter Property="BorderThickness" Value="0"/>
                      </Style>
                      <!-- Targeted style to hide the clear button -->
                      <Style TargetType="Button" x:Key="AutoSuggestBoxDeleteButtonStyle">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Setter Property="Width" Value="0"/>
                      </Style>
                  </AutoSuggestBox.Resources>
              </AutoSuggestBox>
          </Grid>

          <Button x:Name="AddOrderButton" Grid.Column="1" Click="CreateSupplyOrder_Click" Background="{StaticResource AppPurpleBrush}" Foreground="White" 
                  CornerRadius="20" Padding="16,10" MinHeight="48" Style="{StaticResource ColorPreservingButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE710;" FontSize="15" Foreground="White"/>
              <TextBlock Text="Create Supply Order" VerticalAlignment="Center" FontWeight="SemiBold" FontFamily="{StaticResource AppDefaultFontFamily}"/>
            </StackPanel>
          </Button>
        </Grid>
  
        <!-- Table -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20">
          <Grid>
              <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
  
              <!-- Table Header -->
              <Border Grid.Row="0" Background="{ThemeResource ControlFillColorDefaultBrush}"
                      CornerRadius="20" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="0,0,0,1" Padding="16,14">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1.5*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="ORDER ID" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="{StaticResource AppDefaultFontFamily}"/>
                  <TextBlock Grid.Column="1" Text="SUPPLIER" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="{StaticResource AppDefaultFontFamily}"/>
                  <TextBlock Grid.Column="2" Text="IMPORT DATE" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="{StaticResource AppDefaultFontFamily}"/>
                  <TextBlock Grid.Column="3" Text="TOTAL COST" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Right" FontFamily="{StaticResource AppDefaultFontFamily}"/>
                </Grid>
              </Border>
  
              <!-- Loading State -->
              <StackPanel Grid.Row="1" Visibility="{Binding IsLoadingOrders, Converter={StaticResource BoolToVisibilityConverter}}">
                  <controls:OrderSkeletonRow/>
                  <controls:OrderSkeletonRow/>
                  <controls:OrderSkeletonRow/>
              </StackPanel>
  
              <!-- Table Body -->
              <ListView Grid.Row="1" ItemsSource="{Binding SupplyOrders}" SelectionMode="None" Padding="0,4"
                        Visibility="{Binding IsLoadingOrders, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="16,0"/>
                        <Setter Property="MinHeight" Value="56"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="m:SupplyOrder">
                    <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="1*"/>
                          <ColumnDefinition Width="2*"/>
                          <ColumnDefinition Width="1.5*"/>
                          <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind IdDisplay}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" FontFamily="{StaticResource AppDefaultFontFamily}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind SupplierName}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="{StaticResource AppDefaultFontFamily}"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind ImportDateDisplay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="{StaticResource AppDefaultFontFamily}"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind TotalCost, Converter={StaticResource CurrencyFormatter}}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource AppPurpleBrush}" FontWeight="SemiBold" FontSize="13" FontFamily="{StaticResource AppDefaultFontFamily}"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
          </Grid>
        </Border>
  
        <!-- Table Footer -->
        <Border Grid.Row="2" 
                BorderThickness="0"
                Margin="-20,0,-20,-20" Padding="24,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Spacing="4">
              <TextBlock Text="Showing" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="{StaticResource AppDefaultFontFamily}"/>
              <TextBlock Text="{Binding OrderDisplayFrom}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" FontFamily="{StaticResource AppDefaultFontFamily}"/>
              <TextBlock Text="to" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="{StaticResource AppDefaultFontFamily}"/>
              <TextBlock Text="{Binding OrderDisplayTo}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" FontFamily="{StaticResource AppDefaultFontFamily}"/>
              <TextBlock Text="of" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="{StaticResource AppDefaultFontFamily}"/>
              <TextBlock Text="{Binding OrderTotalItems}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" FontFamily="{StaticResource AppDefaultFontFamily}"/>
              <TextBlock Text="orders" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="{StaticResource AppDefaultFontFamily}"/>
            </StackPanel>
  
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        HorizontalAlignment="Right"
                        x:Name="OrderPaginationPanel"/>
          </Grid>
        </Border>
    </Grid>

  </Grid>
</Page>
