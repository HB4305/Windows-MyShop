<Page x:Class="MyShop.Views.CustomerOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:MyShop.Controls"
      xmlns:local="using:MyShop.Views"
      xmlns:m="using:MyShop.Models"
      xmlns:vm="using:MyShop.ViewModels"
      xmlns:conv="using:MyShop.Converters"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Page.Resources>
    <!-- ══ Converters ══ -->
    <conv:OrderStatusToBrushConverter x:Key="OrderStatusToBrushConverter"/>
    <conv:OrderStatusToForegroundConverter x:Key="OrderStatusToForegroundConverter"/>
    <conv:PaymentStatusToBrushConverter x:Key="PaymentStatusToBrushConverter"/>
    <conv:PaymentStatusToForegroundConverter x:Key="PaymentStatusToForegroundConverter"/>
    <conv:CurrencyConverter x:Key="CurrencyConverter"/>
    <conv:DateTimeOffsetConverter x:Key="DateTimeOffsetConverter"/>
    <conv:LineTotalConverter x:Key="LineTotalConverter"/>
    <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
    <conv:OrderIdConverter x:Key="OrderIdConverter"/>
    <conv:CurrentPageEndConverter x:Key="CurrentPageEndConverter"/>
    <conv:ItemIndexConverter x:Key="ItemIndexConverter"/>

    <!-- ══ ListViewItem Style (selected row highlight) ══ -->
    <Style x:Key="OrderListViewItem" TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderThickness="0"
                    CornerRadius="8"
                    Padding="0">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Root" Property="Background"
                        Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
              </Trigger>
              <Trigger Property="IsPointerOver" Value="True">
                <Setter TargetName="Root" Property="Background"
                        Value="{ThemeResource ControlFillColorDefaultBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ══ Accent Colors ══ -->
    <SolidColorBrush x:Key="PurpleBrush"       Color="#8B52FF"/>
    <SolidColorBrush x:Key="PurpleLightBrush"  Color="#1A8B52FF"/> <!-- Faint purple -->
    <SolidColorBrush x:Key="AmberBrush"        Color="#D97706"/>
    <SolidColorBrush x:Key="BlueBrush"         Color="#2563EB"/>
    <SolidColorBrush x:Key="GreenBrush"        Color="#059669"/>
    <SolidColorBrush x:Key="GreenDarkBrush"    Color="#065F46"/>
    <SolidColorBrush x:Key="RedLightBrush"     Color="#FEE2E2"/>
    <SolidColorBrush x:Key="RedBrush"          Color="#EF4444"/>
    <SolidColorBrush x:Key="RedBorderBrush"    Color="#FECACA"/>

    <!-- ══ Tab Count Badge (active tab) ══ -->
    <Style x:Key="TabCountBadgeActive" TargetType="Border">
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Background" Value="#FFFFFF4D"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="MinWidth" Value="20"/>
    </Style>

    <!-- ══ Card ══ -->
    <Style x:Key="CardBorder" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
      <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style x:Key="StatusBadgeBase" TargetType="Border">
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Padding" Value="10,4"/>
    </Style>

    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource PurpleBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="SecondaryBtn" TargetType="Button">
      <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
    </Style>

    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <!-- ══ Search Box ══ -->
    <Style x:Key="SearchBoxBorder" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
      <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style x:Key="SearchBoxText" TargetType="TextBox">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="0,8,10,8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
    </Style>

    <!-- ══ Text Styles ══ -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource AppDefaultFontFamily}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
    </Style>

    <Style x:Key="DetailValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="ms-appx:///Assets/Momo_Signature/MomoSignature-Regular.ttf#Momo Signature"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="TableHeaderText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
    </Style>

    <!-- ══ Table Row Style ══ -->
    <Style x:Key="TableRow" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="0,10"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="TableRowHover" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="0,10"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ══ Tab Button Style ══ -->
    <Style x:Key="TabBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="TabBtnActive" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource PurpleBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="ExtraBold"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ══ Tab Count Badge (inactive tab) ══ -->
    <Style x:Key="TabCountBadge" TargetType="Border">
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="MinWidth" Value="20"/>
    </Style>

    <!-- ══ Pagination Button ══ -->
    <Style x:Key="PageBtn" TargetType="Button">
      <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
    </Style>

    <Style x:Key="PageBtnActive" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource PurpleBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ══ DataTemplate: Order Table Row ══ -->
    <DataTemplate x:Key="OrderTableRowTemplate" x:DataType="m:CustomerOrder">
      <Border x:Name="RowBorder" Padding="12,10">
        <Grid VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="130"/>
          </Grid.ColumnDefinitions>

          <!-- Order ID -->
          <TextBlock Grid.Column="0"
                     Text="{x:Bind Id, Mode=OneWay, Converter={StaticResource OrderIdConverter}}"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource PurpleBrush}"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"/>

          <!-- Customer -->
          <TextBlock Grid.Column="1"
                     Text="{x:Bind CustomerName, Mode=OneWay}"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"
                     Padding="0,0,8,0"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"/>

          <!-- Phone -->
          <TextBlock Grid.Column="2"
                     Text="{x:Bind CustomerPhone, Mode=OneWay}"
                     FontSize="12"
                     Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"/>

          <!-- Staff -->
          <TextBlock Grid.Column="3"
                     Text="{x:Bind SellerName, Mode=OneWay}"
                     FontSize="12"
                     Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"/>

          <!-- Date -->
          <TextBlock Grid.Column="4"
                     Text="{x:Bind CreatedAt, Mode=OneWay, Converter={StaticResource DateTimeOffsetConverter}}"
                     FontSize="12"
                     Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"/>

          <!-- Order Type -->
          <TextBlock Grid.Column="5"
                     Text="{x:Bind OrderType, Mode=OneWay}"
                     FontSize="12"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"/>

          <!-- Status -->
          <Border Grid.Column="6"
                  Style="{StaticResource StatusBadgeBase}"
                  Background="{x:Bind Status, Mode=OneWay, Converter={StaticResource OrderStatusToBrushConverter}}"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center">
            <TextBlock Text="{x:Bind Status, Mode=OneWay}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource OrderStatusToForegroundConverter}}"/>
          </Border>
          <!-- Payment Status -->
          <Border Grid.Column="7"
                  Style="{StaticResource StatusBadgeBase}"
                  Background="{x:Bind PaymentStatus, Mode=OneWay, Converter={StaticResource PaymentStatusToBrushConverter}}"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center">
            <TextBlock Text="{x:Bind PaymentStatus, Mode=OneWay}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{x:Bind PaymentStatus, Mode=OneWay, Converter={StaticResource PaymentStatusToForegroundConverter}}"/>
          </Border>

          <!-- Payment Method -->
          <TextBlock Grid.Column="8"
                     Text="{x:Bind PaymentMethod, Mode=OneWay}"
                     FontSize="12"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"/>

          <!-- Total -->
          <TextBlock Grid.Column="9"
                     Text="{x:Bind TotalAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                     FontSize="14"
                     FontWeight="Bold"
                     Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter TargetName="RowBorder" Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ══ DataTemplate: Order Detail Item ══ -->
    <DataTemplate x:Key="OrderDetailItemTemplate" x:DataType="m:OrderDetail">
      <Border BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
              BorderThickness="0,0,0,1"
              Padding="0,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0"
                  Width="36" Height="36"
                  CornerRadius="8"
                  Background="{ThemeResource ControlFillColorSecondaryBrush}"
                  Margin="0,0,12,0">
            <TextBlock FontFamily="Segoe MDL2 Assets"
                       Text="&#xE7BF;"
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
          </Border>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind ItemName}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{x:Bind QuantityPriceDisplay}"
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,2,0,0"/>
          </StackPanel>

          <TextBlock Grid.Column="2"
                     Text="{x:Bind UnitPriceDisplay}"
                     FontSize="12"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     VerticalAlignment="Center"
                     Margin="12,0"/>

          <TextBlock Grid.Column="3"
                     Text="{x:Bind TotalPriceDisplay}"
                     FontSize="13"
                     FontWeight="Bold"
                     Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                     VerticalAlignment="Center"
                     MinWidth="72"
                     TextAlignment="Right"/>
        </Grid>
      </Border>
    </DataTemplate>
    <!-- Pagination Button Styles -->
    <Style x:Key="PageBtn" TargetType="Button">
      <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
    </Style>

    <Style x:Key="PageBtnActive" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource PurpleBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

  </Page.Resources>

  <Grid x:Name="OrderRoot" Margin="0" SizeChanged="OrderRoot_SizeChanged">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="StatsNarrowState">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0"/>
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="StatsSpacerCol1.Width" Value="0"/>
            <Setter Target="StatsSpacerCol2.Width" Value="0"/>
            <Setter Target="StatsSpacerCol3.Width" Value="0"/>
            <Setter Target="StatsValueCol2.Width" Value="0"/>
            <Setter Target="StatsValueCol3.Width" Value="0"/>
            <Setter Target="StatsValueCol4.Width" Value="0"/>
            <Setter Target="StatsPendingCard.(Grid.Row)" Value="1"/>
            <Setter Target="StatsPendingCard.(Grid.Column)" Value="0"/>
            <Setter Target="StatsProcessingCard.(Grid.Row)" Value="2"/>
            <Setter Target="StatsProcessingCard.(Grid.Column)" Value="0"/>
            <Setter Target="StatsRevenueCard.(Grid.Row)" Value="3"/>
            <Setter Target="StatsRevenueCard.(Grid.Column)" Value="0"/>
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="StatsMediumState">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="900"/>
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="StatsSpacerCol1.Width" Value="12"/>
            <Setter Target="StatsSpacerCol2.Width" Value="0"/>
            <Setter Target="StatsSpacerCol3.Width" Value="0"/>
            <Setter Target="StatsValueCol2.Width" Value="*"/>
            <Setter Target="StatsValueCol3.Width" Value="0"/>
            <Setter Target="StatsValueCol4.Width" Value="0"/>
            <Setter Target="StatsPendingCard.(Grid.Row)" Value="0"/>
            <Setter Target="StatsPendingCard.(Grid.Column)" Value="2"/>
            <Setter Target="StatsProcessingCard.(Grid.Row)" Value="1"/>
            <Setter Target="StatsProcessingCard.(Grid.Column)" Value="0"/>
            <Setter Target="StatsRevenueCard.(Grid.Row)" Value="1"/>
            <Setter Target="StatsRevenueCard.(Grid.Column)" Value="2"/>
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="StatsWideState">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1300"/>
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="StatsSpacerCol1.Width" Value="8"/>
            <Setter Target="StatsSpacerCol2.Width" Value="8"/>
            <Setter Target="StatsSpacerCol3.Width" Value="8"/>
            <Setter Target="StatsValueCol2.Width" Value="*"/>
            <Setter Target="StatsValueCol3.Width" Value="*"/>
            <Setter Target="StatsValueCol4.Width" Value="*"/>
            <Setter Target="StatsPendingCard.(Grid.Row)" Value="0"/>
            <Setter Target="StatsPendingCard.(Grid.Column)" Value="2"/>
            <Setter Target="StatsProcessingCard.(Grid.Row)" Value="0"/>
            <Setter Target="StatsProcessingCard.(Grid.Column)" Value="4"/>
            <Setter Target="StatsRevenueCard.(Grid.Row)" Value="0"/>
            <Setter Target="StatsRevenueCard.(Grid.Column)" Value="6"/>
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="420"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- LEFT PANEL: ORDER LIST                          -->
    <!-- ═══════════════════════════════════════════════ -->
    <Grid x:Name="OrderListPanel" Grid.Column="0">

      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Page Title -->
      <controls:AppPageHeader Grid.Row="0"
                              Margin="24,20,24,16"
                              Title="Orders Management"
                              Subtitle="Manage and track all your customer orders."/>

      <!-- Stats Cards Row -->
      <Border Grid.Row="1" Margin="24,0,24,16">
        <Grid x:Name="StatsCardsGrid" RowSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="StatsSpacerCol1" Width="8"/>
            <ColumnDefinition x:Name="StatsValueCol2" Width="*"/>
            <ColumnDefinition x:Name="StatsSpacerCol2" Width="8"/>
            <ColumnDefinition x:Name="StatsValueCol3" Width="*"/>
            <ColumnDefinition x:Name="StatsSpacerCol3" Width="8"/>
            <ColumnDefinition x:Name="StatsValueCol4" Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Total -->
          <Border x:Name="StatsTotalCard" Grid.Column="0" CornerRadius="20" Padding="16,12"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1">
            <StackPanel>
              <TextBlock Text="Total Orders" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
              <Grid>
                  <TextBlock FontSize="22"
                             FontWeight="Bold"
                             FontFamily="{StaticResource AppDefaultFontFamily}"
                             Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                             Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Run Text="{Binding TotalOrders, Mode=OneWay}"/>
                    <Run Text=" orders"
                         FontSize="12"
                         FontWeight="Normal"
                         FontFamily="{StaticResource AppDefaultFontFamily}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </TextBlock>
                  <controls:ShimmerLoadingControl Width="100" Height="28" HorizontalAlignment="Left" 
                                                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Pending -->
            <Border x:Name="StatsPendingCard" Grid.Column="2" CornerRadius="20" Padding="16,12"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1">
            <StackPanel>
              <TextBlock Text="Pending" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
              <Grid>
                  <TextBlock Text="{Binding PendingCount}"
                             FontSize="22"
                             FontWeight="Bold"
                             FontFamily="{StaticResource AppDefaultFontFamily}"
                             Foreground="{StaticResource AmberBrush}"
                             Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                  <controls:ShimmerLoadingControl Width="40" Height="28" HorizontalAlignment="Left" 
                                                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Processing -->
            <Border x:Name="StatsProcessingCard" Grid.Column="4" CornerRadius="20" Padding="16,12"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1">
            <StackPanel>
              <TextBlock Text="Processing" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
              <Grid>
                  <TextBlock Text="{Binding ProcessingCount}"
                             FontSize="22"
                             FontWeight="Bold"
                             FontFamily="{StaticResource AppDefaultFontFamily}"
                             Foreground="{StaticResource BlueBrush}"
                             Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                  <controls:ShimmerLoadingControl Width="40" Height="28" HorizontalAlignment="Left" 
                                                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Revenue -->
            <Border x:Name="StatsRevenueCard" Grid.Column="6" CornerRadius="20" Padding="16,12"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1">
            <StackPanel>
              <TextBlock Text="Total Revenue" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
              <Grid>
                  <TextBlock Text="{Binding TotalRevenue, Converter={StaticResource CurrencyConverter}}"
                             FontSize="18"
                             FontWeight="Bold"
                             FontFamily="{StaticResource AppDefaultFontFamily}"
                             Foreground="{StaticResource GreenBrush}"
                             TextTrimming="CharacterEllipsis"
                             Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                  <controls:ShimmerLoadingControl Width="100" Height="24" HorizontalAlignment="Left" 
                                                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Tabs Bar -->
      <Border Grid.Row="2" Margin="24,0,24,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Tab Buttons -->
          <ScrollViewer Grid.Column="0"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <!-- All Tab -->
              <Button x:Name="TabAll"
                      Click="TabAll_Click"
                      Style="{StaticResource TabBtnActive}">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="All" VerticalAlignment="Center"/>
                  <Border Style="{StaticResource TabCountBadgeActive}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalOrders}"
                               FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                  </Border>
                </StackPanel>
              </Button>

              <!-- Pending Tab -->
              <Button x:Name="TabPending"
                      Click="TabPending_Click"
                      Style="{StaticResource TabBtn}">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="Pending" VerticalAlignment="Center"/>
                  <Border Style="{StaticResource TabCountBadge}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PendingCount}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </Border>
                </StackPanel>
              </Button>

              <!-- Processing Tab -->
              <Button x:Name="TabProcessing"
                      Click="TabProcessing_Click"
                      Style="{StaticResource TabBtn}">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="Processing" VerticalAlignment="Center"/>
                  <Border Style="{StaticResource TabCountBadge}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProcessingCount}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </Border>
                </StackPanel>
              </Button>

              <!-- Delivered Tab -->
              <Button x:Name="TabDelivered"
                      Click="TabDelivered_Click"
                      Style="{StaticResource TabBtn}">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="Delivered" VerticalAlignment="Center"/>
                  <Border Style="{StaticResource TabCountBadge}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CompletedCount}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </Border>
                </StackPanel>
              </Button>

              <!-- Cancelled Tab -->
              <Button x:Name="TabCancelled"
                      Click="TabCancelled_Click"
                      Style="{StaticResource TabBtn}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Cancelled"/>
                  <Border Style="{StaticResource TabCountBadge}">
                    <TextBlock Text="{Binding CancelledCount}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </Border>
                </StackPanel>
              </Button>
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Column="1"
                  MinHeight="48"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="24"
                  Padding="16,4"
                  MinWidth="280"
                  Margin="16,0,0,0">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0"
                       Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText="Search orders..."
                       BorderThickness="0" Background="Transparent" Padding="0,6" VerticalAlignment="Center"
                       FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
              <Button Grid.Column="1" Content="&#xE721;" FontFamily="Segoe MDL2 Assets" 
                      Background="Transparent" BorderThickness="0" Padding="8"
                      Foreground="{StaticResource AppPurpleBrush}" Style="{StaticResource ColorPreservingButtonStyle}"/>
            </Grid>
          </Border>

        </Grid>
      </Border>

      <!-- Table Container -->
      <Border Grid.Row="3" Margin="24,0,24,0">
        <Grid>
          <!-- Actual content will be inside the Table structure below -->

          <!-- Table with header -->
          <Border CornerRadius="20"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  Padding="0">

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Disabled">
              <Grid MinWidth="1400">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Table Header (fixed, outside scroll) -->
                <Border Grid.Row="0"
                        BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="80"/>
                      <ColumnDefinition Width="190"/>
                      <ColumnDefinition Width="130"/>
                      <ColumnDefinition Width="170"/>
                      <ColumnDefinition Width="140"/>
                      <ColumnDefinition Width="120"/>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="120"/>
                      <ColumnDefinition Width="130"/>
                      <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ID" Style="{StaticResource TableHeaderText}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Customer" Style="{StaticResource TableHeaderText}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Phone" Style="{StaticResource TableHeaderText}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="Staff" Style="{StaticResource TableHeaderText}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="Date" Style="{StaticResource TableHeaderText}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="Order Type" Style="{StaticResource TableHeaderText}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="Status" Style="{StaticResource TableHeaderText}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Grid.Column="7" Text="Payment Status" Style="{StaticResource TableHeaderText}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Grid.Column="8" Text="Payment Method" Style="{StaticResource TableHeaderText}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Grid.Column="9" Text="Total" Style="{StaticResource TableHeaderText}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                  </Grid>
                </Border>

                <!-- Table Body: ListView (clickable rows) -->
                <Grid Grid.Row="1">
                    <ListView ItemsSource="{Binding PaginatedOrders}"
                              ItemTemplate="{StaticResource OrderTableRowTemplate}"
                              ItemContainerStyle="{StaticResource OrderListViewItem}"
                              SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                              SelectionMode="Single"
                              SelectionChanged="OrderList_SelectionChanged"
                              BorderThickness="0"
                              Background="Transparent"
                              Padding="0,4"
                              Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                    <!-- Skeleton Loading State (Aligned with rows) -->
                    <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <controls:CustomerOrderSkeletonRow/>
                        <controls:CustomerOrderSkeletonRow/>
                        <controls:CustomerOrderSkeletonRow/>
                        <controls:CustomerOrderSkeletonRow/>
                        <controls:CustomerOrderSkeletonRow/>
                        <controls:CustomerOrderSkeletonRow/>
                        <controls:CustomerOrderSkeletonRow/>
                        <controls:CustomerOrderSkeletonRow/>
                    </StackPanel>
                </Grid>

                <!-- Empty State (fixed overlay, shows when Count==0) -->
                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10"
                            Canvas.ZIndex="10"
                            Visibility="{Binding PaginatedOrders.Count, Converter={StaticResource CountToVisibilityConverter}}">
                  <Border Width="60" Height="60" CornerRadius="30"
                          Background="{StaticResource PurpleLightBrush}" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE7BC;"
                               FontSize="28"
                               Foreground="{StaticResource PurpleBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="No orders found"
                             FontSize="15" FontWeight="SemiBold"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             HorizontalAlignment="Center"/>
                  <TextBlock Text="No orders in this category yet."
                             FontSize="13"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                             HorizontalAlignment="Center"/>
                </StackPanel>

              </Grid>
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>

      <!-- Pagination Bar -->
      <Border Grid.Row="4"
              Padding="24,10"
              Margin="0,8,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Showing X-Y of Z -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
            <TextBlock Text="Showing" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            <TextBlock Text="{Binding StartIndex}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            <TextBlock Text="to" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            <TextBlock Text="{Binding EndIndex}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            <TextBlock Text="of" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            <TextBlock Text="{Binding FilteredCount}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            <TextBlock Text="orders" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
          </StackPanel>

          <!-- Pagination Buttons -->
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="4"
                      x:Name="PaginationPanel"/>

        </Grid>
      </Border>

    </Grid>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- RIGHT PANEL: ORDER DETAIL                      -->
    <!-- ═══════════════════════════════════════════════ -->
    <Border x:Name="OrderDetailPanel"
            Grid.Column="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Visibility="{Binding ShowDetailPanel, Converter={StaticResource BoolToVisibilityConverter}}">

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Detail Header -->
        <Border Grid.Row="0"
                BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,16">

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource IconBtn}"
                    Click="CloseDetail_Click"
                    ToolTipService.ToolTip="Close">
              <TextBlock FontFamily="Segoe MDL2 Assets"
                         Text="&#xE72B;"
                         FontSize="16"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Button>

            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
              <TextBlock FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                <Run Text="Order #"/>
                <Run Text="{Binding SelectedOrder.Id, Mode=OneWay}"/>
              </TextBlock>
              <TextBlock Text="{Binding SelectedOrder.CreatedAt, Converter={StaticResource DateTimeOffsetConverter}}"
                         FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <Border Grid.Column="2"
                    Style="{StaticResource StatusBadgeBase}"
                    Background="{Binding SelectedOrder.Status, Converter={StaticResource OrderStatusToBrushConverter}}"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding SelectedOrder.Status}"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{Binding SelectedOrder.Status, Converter={StaticResource OrderStatusToForegroundConverter}}"/>
            </Border>
          </Grid>
        </Border>

        <!-- Detail Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="20,16">

          <StackPanel Spacing="16">

            <!-- Customer Info Card -->
            <Border Style="{StaticResource CardBorder}" Padding="16">
              <StackPanel Spacing="12">
                <TextBlock Text="CUSTOMER" Style="{StaticResource SectionTitle}"/>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <Border Grid.Column="0"
                          Width="44" Height="44"
                          CornerRadius="22"
                          Background="{StaticResource PurpleLightBrush}"
                          Margin="0,0,14,0"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedOrder.CustomerName}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource PurpleBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="36"/>
                  </Border>

                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{Binding SelectedOrder.CustomerName}"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock FontFamily="Segoe MDL2 Assets"
                                 Text="&#xE717;"
                                 FontSize="11"
                                 Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                 VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding SelectedOrder.CustomerPhone}"
                                 FontSize="13"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>

                <Border BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
                        BorderThickness="0,1,0,0" Margin="0,4,0,0"/>

                <StackPanel Spacing="2">
                  <TextBlock Text="Shipping Address" Style="{StaticResource MutedText}"/>
                  <TextBlock Text="{Binding SelectedOrder.ShippingAddress}"
                             FontSize="13"
                             Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Order Items Card -->
            <Border Style="{StaticResource CardBorder}" Padding="16">
              <StackPanel Spacing="12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="ITEMS" Style="{StaticResource SectionTitle}"/>
                  <Border Grid.Column="1"
                          Background="{ThemeResource ControlFillColorSecondaryBrush}"
                          CornerRadius="20"
                          Padding="8,4">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                      <Run Text="{Binding CurrentDetails.Count, Mode=OneWay}"/>
                      <Run Text=" items"/>
                    </TextBlock>
                  </Border>
                </Grid>

                <Grid>
                    <ItemsControl ItemsSource="{Binding CurrentDetails, Mode=OneWay}"
                                  ItemTemplate="{StaticResource OrderDetailItemTemplate}"
                                  Visibility="{Binding IsDetailLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    
                    <StackPanel Visibility="{Binding IsDetailLoading, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="10">
                        <controls:ShimmerLoadingControl Height="60" CornerRadius="8"/>
                        <controls:ShimmerLoadingControl Height="60" CornerRadius="8"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="No items in this order."
                           FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding CurrentDetails.Count, Converter={StaticResource CountToVisibilityConverter}}"/>

                <Border BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
                        BorderThickness="0,1,0,0" Margin="0,8,0,0"/>

                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0"
                             Text="Order Total"
                             FontSize="14" FontWeight="SemiBold"
                             Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1"
                             Text="{Binding SelectedOrder.TotalAmount, Converter={StaticResource CurrencyConverter}}"
                             FontSize="18" FontWeight="Bold"
                             Foreground="{StaticResource PurpleBrush}"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsDetailLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                  <controls:ShimmerLoadingControl Grid.Column="1" Width="80" Height="24" HorizontalAlignment="Right"
                                                  Visibility="{Binding IsDetailLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Order Info Card -->
            <Border Style="{StaticResource CardBorder}" Padding="16">
              <StackPanel Spacing="12">
                <TextBlock Text="ORDER INFO" Style="{StaticResource SectionTitle}"/>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Order Type" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="{Binding SelectedOrder.OrderType}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Margin="0,2,0,0"/>
                  </StackPanel>

                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Payment Status" Style="{StaticResource MutedText}"/>
                    <Border Style="{StaticResource StatusBadgeBase}"
                            Background="{Binding SelectedOrder.PaymentStatus, Converter={StaticResource PaymentStatusToBrushConverter}}"
                            HorizontalAlignment="Left"
                            Margin="0,2,0,0">
                      <TextBlock Text="{Binding SelectedOrder.PaymentStatus}"
                                 FontSize="11" FontWeight="SemiBold"
                                 Foreground="{StaticResource GreenDarkBrush}"/>
                    </Border>
                  </StackPanel>
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Payment Method" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="{Binding SelectedOrder.PaymentMethod}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Margin="0,2,0,0"/>
                  </StackPanel>

                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Received Amount" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="{Binding SelectedOrder.ReceivedAmount, Converter={StaticResource CurrencyConverter}}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Margin="0,2,0,0"/>
                  </StackPanel>
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Shift ID" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="{Binding SelectedOrder.ShiftId}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Margin="0,2,0,0"/>
                  </StackPanel>

                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Staff" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="{Binding SelectedOrder.SellerName}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Margin="0,2,0,0"/>
                  </StackPanel>
                </Grid>

                <StackPanel Spacing="2">
                  <TextBlock Text="Notes" Style="{StaticResource MutedText}"/>
                  <TextBlock Text="{Binding SelectedOrder.Notes}"
                             FontSize="13"
                             Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Update Status Card -->
            <Border Style="{StaticResource CardBorder}" Padding="16">
              <StackPanel Spacing="10">
                <TextBlock Text="UPDATE STATUS" Style="{StaticResource SectionTitle}"/>

                <ItemsControl x:Name="StatusButtonsPanel">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <Button x:Name="BtnStatusPending"
                          Content="Pending"
                          Click="StatusPending_Click"
                          Style="{StaticResource SecondaryBtn}"/>
                  <Button x:Name="BtnStatusProcessing"
                          Content="Processing"
                          Click="StatusProcessing_Click"
                          Style="{StaticResource SecondaryBtn}"/>
                  <Button x:Name="BtnStatusShipped"
                          Content="Shipped"
                          Click="StatusShipped_Click"
                          Style="{StaticResource SecondaryBtn}"/>
                  <Button x:Name="BtnStatusDelivered"
                          Content="Delivered"
                          Click="StatusDelivered_Click"
                          Style="{StaticResource SecondaryBtn}"/>
                  <Button x:Name="BtnStatusCancelled"
                          Content="Cancelled"
                          Click="StatusCancelled_Click"
                          Style="{StaticResource SecondaryBtn}"/>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Payment:" Style="{StaticResource SectionTitle}"
                             VerticalAlignment="Center" Margin="0" FontSize="12"/>
                  <Button x:Name="BtnPayPaid"
                          Content="Mark as Paid"
                          Click="PayPaid_Click"
                          Style="{StaticResource SecondaryBtn}"/>
                  <Button x:Name="BtnPayUnpaid"
                          Content="Mark as Unpaid"
                          Click="PayUnpaid_Click"
                          Style="{StaticResource SecondaryBtn}"/>
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- Footer: Order Manifest + Delete -->
        <Border Grid.Row="2"
                BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Print Invoice"
                    Style="{StaticResource SecondaryBtn}"
                    Click="OrderManifest_Click"
                    HorizontalAlignment="Left"/>

            <Button Grid.Column="1"
                    Content="Delete Order"
                    Click="DeleteOrder_Click"
                    Background="{StaticResource RedLightBrush}"
                    Foreground="{StaticResource RedBrush}"
                    BorderBrush="{StaticResource RedBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,8"
                    FontWeight="SemiBold"
                    FontSize="13"/>
          </Grid>
        </Border>

      </Grid>
    </Border>

    <!-- RIGHT PANEL: Empty State -->
    <Border x:Name="OrderEmptyDetailPanel"
            Grid.Column="1"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Visibility="{Binding ShowDetailPanel, Converter={StaticResource InverseBoolConverter}}">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="12">
        <Border Width="72" Height="72" CornerRadius="36"
                Background="{StaticResource PurpleLightBrush}" HorizontalAlignment="Center">
          <TextBlock FontFamily="Segoe MDL2 Assets"
                     Text="&#xE7BC;"
                     FontSize="32"
                     Foreground="{StaticResource PurpleBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Select an order"
                   FontSize="18" FontWeight="SemiBold"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="Click an order from the list to view its details."
                   FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="220"
                   TextAlignment="Center"/>
      </StackPanel>
    </Border>

  </Grid>
</Page>
