<ContentDialog
	x:Class="MyShop.Views.Forms.AddEditCategoryForm"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:conv="using:MyShop.Converters"
	mc:Ignorable="d"
	x:Name="DialogRoot"
	Width="480">

	<ContentDialog.Resources>
		<conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
		<CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
	</ContentDialog.Resources>

	<StackPanel Spacing="20" Margin="4,0,4,0" Width="460">

		<!-- Custom header with icon -->
		<StackPanel Spacing="16">
			<!-- Category icon circle -->
			<Border Background="{ThemeResource AppAccentBrushLow}"
					CornerRadius="24"
					Width="48" Height="48"
					HorizontalAlignment="Left">
				<TextBlock FontFamily="Segoe MDL2 Assets"
						   Text="&#xE8EC;"
						   FontSize="20"
						   Foreground="{ThemeResource AppAccentBrush}"
						   HorizontalAlignment="Center"
						   VerticalAlignment="Center"/>
			</Border>

			<!-- Title -->
			<StackPanel Spacing="4">
				<TextBlock x:Name="FormTitle"
						   FontSize="18"
						   FontWeight="Bold"
						   Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
				<TextBlock x:Name="FormSubtitle"
						   FontSize="12"
						   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
			</StackPanel>
		</StackPanel>

		<!-- Divider -->
		<Border Background="{ThemeResource ControlStrokeColorDefaultBrush}" Height="1" Margin="-4,0,-4,0"/>

		<!-- Form fields -->
		<StackPanel Spacing="16">

			<!-- Category Name field -->
			<StackPanel Spacing="6">
				<StackPanel Orientation="Horizontal" Spacing="4">
					<TextBlock Text="Category name"
							   FontSize="13"
							   FontWeight="SemiBold"
							   Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
					<TextBlock Text="*"
							   FontSize="13"
							   Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
				</StackPanel>
				<Border x:Name="CategoryNameWrapper"
						Background="{ThemeResource ControlFillColorDefaultBrush}"
						BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
						BorderThickness="1"
						CornerRadius="24">
					<TextBox x:Name="CategoryNameTextBox"
							 PlaceholderText="e.g. Running Shoes, Basketball..."
							 TextChanged="CategoryNameTextBox_TextChanged"
							 MaxLength="100"
							 Background="Transparent"
							 BorderThickness="0"
							 Padding="16,10"
							 Text="{x:Bind CategoryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							 GotFocus="TextBox_GotFocus"
							 LostFocus="TextBox_LostFocus"
							 FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans">
						<TextBox.Resources>
							<Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
							<Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
						</TextBox.Resources>
					</TextBox>
				</Border>
				<!-- Validation message -->
				<Border Visibility="{x:Bind NameValidationMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"
						Padding="0,2,0,0">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<TextBlock FontFamily="Segoe MDL2 Assets"
								   Text="&#xEA39;"
								   FontSize="10"
								   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
								   VerticalAlignment="Center"/>
						<TextBlock Text="{x:Bind NameValidationMessage, Mode=OneWay}"
								   FontSize="11"
								   Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
					</StackPanel>
				</Border>
			</StackPanel>

			<!-- Description field -->
			<StackPanel Spacing="6">
				<StackPanel Orientation="Horizontal" Spacing="6">
					<TextBlock Text="Description"
							   FontSize="13"
							   FontWeight="SemiBold"
							   Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
					<Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
							CornerRadius="24"
							Padding="6,1">
						<TextBlock Text="Optional"
								   FontSize="10"
								   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
					</Border>
				</StackPanel>
				<Border x:Name="DescriptionWrapper"
						Background="{ThemeResource ControlFillColorDefaultBrush}"
						BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
						BorderThickness="1"
						CornerRadius="24">
					<TextBox x:Name="DescriptionTextBox"
							 PlaceholderText="Brief description of this category..."
							 TextWrapping="Wrap"
							 AcceptsReturn="True"
							 MinHeight="90"
							 MaxLength="300"
							 Background="Transparent"
							 BorderThickness="0"
							 Padding="16,10"
							 Text="{x:Bind CategoryDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							 GotFocus="TextBox_GotFocus"
							 LostFocus="TextBox_LostFocus"
							 FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans">
						<TextBox.Resources>
							<Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
							<Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
						</TextBox.Resources>
					</TextBox>
				</Border>
			</StackPanel>
		</StackPanel>

		<!-- Divider -->
		<Border Background="{ThemeResource ControlStrokeColorDefaultBrush}" Height="1" Margin="-4,0,-4,0"/>

		<!-- Action buttons -->
		<Grid ColumnSpacing="10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- Cancel button -->
			<Button Grid.Column="0"
					x:Name="CancelBtn"
					Click="CancelBtn_Click"
					HorizontalAlignment="Stretch"
					Background="Transparent"
					BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
					BorderThickness="1"
					CornerRadius="24"
					Padding="14,10"
                  Style="{StaticResource ColorPreservingButtonStyle}">
				<Button.Resources>
					<SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SubtleFillColorSecondary}"/>
					<SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource ControlStrokeColorDefault}"/>
					<SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource TextFillColorPrimaryBrush}"/>
				</Button.Resources>
				<TextBlock Text="Cancel"
						   FontSize="13"
						   FontWeight="SemiBold"
						   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
						   HorizontalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
			</Button>

			<!-- Save / Confirm button (purple accent, same as Add Category) -->
			<Button Grid.Column="1"
					x:Name="SaveBtn"
					Click="SaveBtn_Click"
					HorizontalAlignment="Stretch"
					Background="{StaticResource AppPurpleBrush}"
					Foreground="White"
					BorderThickness="0"
					CornerRadius="24"
					Padding="14,10"
					Style="{StaticResource ColorPreservingButtonStyle}">
				<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
					<TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
					<TextBlock x:Name="SaveBtnText"
							   FontSize="13"
							   FontWeight="SemiBold"
							   Foreground="White" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
				</StackPanel>
			</Button>
		</Grid>
	</StackPanel>
</ContentDialog>

