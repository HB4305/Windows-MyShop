<Page x:Class="MyShop.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:MyShop.Controls"
      xmlns:conv="using:MyShop.Converters"
      xmlns:dashModels="using:MyShop.Models.DashboardModels"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Page.Resources>
    <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    <conv:DateToMonthYearConverter x:Key="DateToMonthYearConverter"/>
    <!-- Accent colors (matching Login) -->
    <SolidColorBrush x:Key="PurpleBrush"
        Color="#8B52FF"/>
    <SolidColorBrush x:Key="PurpleLightBrush"
        Color="#8B52FF"
        Opacity="0.12"/>
    <SolidColorBrush x:Key="PurpleFaintBrush"
        Color="#8B52FF"
        Opacity="0.08"/>

    <!-- Text brushes (Theme-aware) -->
    <StaticResource x:Key="DarkTextBrush"
        ResourceKey="TextFillColorPrimaryBrush"/>
    <StaticResource x:Key="GrayTextBrush"
        ResourceKey="TextFillColorSecondaryBrush"/>
    <StaticResource x:Key="MutedTextBrush"
        ResourceKey="TextFillColorTertiaryBrush"/>
    <SolidColorBrush x:Key="GreenBrush"
        Color="#10B981"/>
    <!-- Better green -->

    <!-- Card style -->
    <Style x:Key="CardBorder"
        TargetType="Border">
      <Setter Property="Background"
          Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
      <Setter Property="BorderBrush"
          Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness"
          Value="1"/>
      <Setter Property="CornerRadius"
          Value="20"/>
      <Setter Property="Padding"
          Value="20"/>
    </Style>

    <!-- KPI Value style -->
    <Style x:Key="KpiValueStyle"
        TargetType="TextBlock">
      <Setter Property="FontFamily"
          Value="{StaticResource AppDefaultFontFamily}"/>
      <Setter Property="FontSize"
          Value="32"/>
      <Setter Property="FontWeight"
          Value="Bold"/>
      <Setter Property="Foreground"
          Value="{ThemeResource TextFillColorPrimaryBrush}"/>
    </Style>

    <!-- KPI Label style -->
    <Style x:Key="KpiLabelStyle"
        TargetType="TextBlock">
      <Setter Property="FontFamily"
          Value="{StaticResource AppDefaultFontFamily}"/>
      <Setter Property="FontSize"
          Value="12"/>
      <Setter Property="Foreground"
          Value="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Setter Property="Margin"
          Value="0,0,0,4"/>
    </Style>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="NarrowState">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0"/>
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="HeaderActionsPanel.(Grid.Row)" Value="1"/>
            <Setter Target="HeaderActionsPanel.(Grid.Column)" Value="0"/>
            <Setter Target="HeaderActionsPanel.HorizontalAlignment" Value="Left"/>
            <Setter Target="HeaderActionsPanel.Margin" Value="0,12,0,0"/>
            <Setter Target="HeaderActionsPanel.Orientation" Value="Vertical"/>
            <Setter Target="KpiSpacerColumn1.Width" Value="0"/>
            <Setter Target="KpiSpacerColumn2.Width" Value="0"/>
            <Setter Target="KpiValueColumn2.Width" Value="0"/>
            <Setter Target="KpiValueColumn3.Width" Value="0"/>
            <Setter Target="KpiCardTwo.(Grid.Row)" Value="1"/>
            <Setter Target="KpiCardTwo.(Grid.Column)" Value="0"/>
            <Setter Target="KpiCardThree.(Grid.Row)" Value="2"/>
            <Setter Target="KpiCardThree.(Grid.Column)" Value="0"/>
            <Setter Target="MainSpacerColumn.Width" Value="0"/>
            <Setter Target="MainRightColumn.Width" Value="0"/>
            <Setter Target="RightContentPanel.(Grid.Row)" Value="1"/>
            <Setter Target="RightContentPanel.(Grid.Column)" Value="0"/>
            <Setter Target="RightContentPanel.Margin" Value="0,16,0,0"/>
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="WideState">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1100"/>
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="HeaderActionsPanel.(Grid.Row)" Value="0"/>
            <Setter Target="HeaderActionsPanel.(Grid.Column)" Value="1"/>
            <Setter Target="HeaderActionsPanel.HorizontalAlignment" Value="Stretch"/>
            <Setter Target="HeaderActionsPanel.Margin" Value="0"/>
            <Setter Target="HeaderActionsPanel.Orientation" Value="Horizontal"/>
            <Setter Target="KpiSpacerColumn1.Width" Value="16"/>
            <Setter Target="KpiSpacerColumn2.Width" Value="16"/>
            <Setter Target="KpiValueColumn2.Width" Value="*"/>
            <Setter Target="KpiValueColumn3.Width" Value="*"/>
            <Setter Target="KpiCardTwo.(Grid.Row)" Value="0"/>
            <Setter Target="KpiCardTwo.(Grid.Column)" Value="2"/>
            <Setter Target="KpiCardThree.(Grid.Row)" Value="0"/>
            <Setter Target="KpiCardThree.(Grid.Column)" Value="4"/>
            <Setter Target="MainSpacerColumn.Width" Value="16"/>
            <Setter Target="MainRightColumn.Width" Value="*"/>
            <Setter Target="RightContentPanel.(Grid.Row)" Value="0"/>
            <Setter Target="RightContentPanel.(Grid.Column)" Value="2"/>
            <Setter Target="RightContentPanel.Margin" Value="0"/>
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="24,24,24,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
  
          <controls:AppPageHeader Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Title="Executive Dashboard"
                                  Subtitle="Real-time performance metrics for ProSport Hub."/>
  
          <!-- Controls -->
          <StackPanel x:Name="HeaderActionsPanel"
            Grid.Column="1"
              Orientation="Horizontal"
              VerticalAlignment="Center"
              Spacing="10">
  
            <!-- Today's Date Display (Non-interactive) -->
            <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="24"
                    MinHeight="44"
                    Padding="16,8">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE787;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{Binding TodayDisplay}" 
                           FontSize="14" 
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" 
                           FontFamily="{StaticResource AppDefaultFontFamily}"/>
              </StackPanel>
            </Border>
  
            <!-- Create Order button -->
            <Button Background="{StaticResource AppPurpleBrush}"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    CornerRadius="24"
                    Padding="20,10"
                    MinHeight="48"
                    Click="CreateOrderButton_Click">
              <StackPanel Orientation="Horizontal"
                  Spacing="6">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                    Text="&#xE710;"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    VerticalAlignment="Center"/>
                <TextBlock Text="Create Order"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    VerticalAlignment="Center" FontFamily="{StaticResource AppDefaultFontFamily}"/>
              </StackPanel>
            </Button>
  
          </StackPanel>
      </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="RootStack" Margin="24,0,24,24" Spacing="20">
        <Grid x:Name="KpiGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="KpiSpacerColumn1" Width="16"/>
            <ColumnDefinition x:Name="KpiValueColumn2" Width="*"/>
            <ColumnDefinition x:Name="KpiSpacerColumn2" Width="16"/>
            <ColumnDefinition x:Name="KpiValueColumn3" Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
  
          <!-- Card 1: Total Products -->
          <Border Grid.Column="0"
              Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="TOTAL PRODUCTS"
                  Style="{StaticResource KpiLabelStyle}"
                  FontWeight="SemiBold"
                  CharacterSpacing="40"
                  FontFamily="{StaticResource AppDefaultFontFamily}"/>
              <Grid>
                  <TextBlock Text="{Binding TotalProductsDisplay}"
                             Style="{StaticResource KpiValueStyle}"
                             Margin="0,4,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                             FontFamily="{StaticResource AppDefaultFontFamily}"/>
                  <controls:ShimmerLoadingControl Width="80" Height="32" Margin="0,4,0,0" HorizontalAlignment="Left" 
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
              </Grid>
            </StackPanel>
          </Border>
  
          <!-- Card 2: Today's Orders -->
          <Border x:Name="KpiCardTwo"
            Grid.Column="2"
              Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="TODAY'S ORDERS"
                  Style="{StaticResource KpiLabelStyle}"
                  CharacterSpacing="40"
                  FontFamily="{StaticResource AppDefaultFontFamily}"/>
              <Grid>
                  <TextBlock Text="{Binding TotalTodayOrdersDisplay}"
                             Style="{StaticResource KpiValueStyle}"
                             Margin="0,4,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                             FontFamily="{StaticResource AppDefaultFontFamily}"/>
                  <controls:ShimmerLoadingControl Width="60" Height="32" Margin="0,4,0,0" HorizontalAlignment="Left"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
              </Grid>
            </StackPanel>
          </Border>
  
          <!-- Card 3: Today's Revenue -->
          <Border x:Name="KpiCardThree"
            Grid.Column="4"
              Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="TODAY'S REVENUE"
                  Style="{StaticResource KpiLabelStyle}"
                  CharacterSpacing="40"
                  FontFamily="{StaticResource AppDefaultFontFamily}"/>
              <Grid>
                  <TextBlock Text="{Binding TodayRevenueDisplay}"
                             Style="{StaticResource KpiValueStyle}"
                             Margin="0,4,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                             FontFamily="{StaticResource AppDefaultFontFamily}"/>
                  <controls:ShimmerLoadingControl Width="120" Height="32" Margin="0,4,0,0" HorizontalAlignment="Left"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
  
        <!-- ═══════════════════════════ MONTHLY REVENUE CHART ═══════════════════════════ -->
        <Border Style="{StaticResource CardBorder}">
          <StackPanel>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Monthly Revenue Analysis"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="{StaticResource AppDefaultFontFamily}"/>
                <TextBlock Text="Daily breakdown of revenue for the current month"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Margin="0,2,0,0" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
              </StackPanel>
              <!-- Legend -->
              <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="6"
                  VerticalAlignment="Center">
                <Border Width="8"
                    Height="8"
                    CornerRadius="24"
                    Background="{StaticResource PurpleBrush}"/>
                <TextBlock Text="Revenue ($)"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
              </StackPanel>
            </Grid>
  
            <!-- Chart Area -->
            <Border Margin="0,16,0,0"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    CornerRadius="24"
                    Height="240"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
              <Canvas x:Name="RevenueChartCanvas"
                      SizeChanged="RevenueChartCanvas_SizeChanged"/>
            </Border>
  
            <!-- X-axis labels -->
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                  Text="DAY 1"
                  FontSize="11"
                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                  HorizontalAlignment="Left" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
              <TextBlock Grid.Column="1"
                  Text="DAY 7"
                  FontSize="11"
                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                  HorizontalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
              <TextBlock Grid.Column="2"
                  Text="DAY 14"
                  FontSize="11"
                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                  HorizontalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
              <TextBlock Grid.Column="3"
                  Text="DAY 21"
                  FontSize="11"
                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                  HorizontalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
              <TextBlock Grid.Column="4"
                  Text="DAY 30"
                  FontSize="11"
                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                  HorizontalAlignment="Right" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            </Grid>
          </StackPanel>
        </Border>
  
        <!-- ═══════════════════════════ TWO COLUMN: LEFT + RIGHT ═══════════════════════════ -->
        <Grid x:Name="MainContentGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="MainSpacerColumn" Width="16"/>
            <ColumnDefinition x:Name="MainRightColumn" Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
  
          <!-- ── LEFT COLUMN ── -->
          <StackPanel Grid.Column="0"
              Spacing="16">
  
            <!-- Top 5 Best Sellers -->
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,0,0,16">
                  <TextBlock FontFamily="Segoe MDL2 Assets"
                      Text="&#xECC7;"
                      FontSize="14"
                      Foreground="{StaticResource PurpleBrush}"
                      VerticalAlignment="Center"/>
                  <TextBlock Text="Top 5 Best Sellers"
                             FontSize="15"
                             FontWeight="SemiBold"
                             Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                             VerticalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                </StackPanel>
  
                <!-- Skeleton loading state -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="16">
                    <StackPanel Spacing="8">
                        <controls:ShimmerLoadingControl Width="180" Height="16" HorizontalAlignment="Left"/>
                        <controls:ShimmerLoadingControl Width="120" Height="12" HorizontalAlignment="Left"/>
                        <controls:ShimmerLoadingControl Width="60" Height="20" CornerRadius="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <controls:ShimmerLoadingControl Width="160" Height="16" HorizontalAlignment="Left"/>
                        <controls:ShimmerLoadingControl Width="100" Height="12" HorizontalAlignment="Left"/>
                        <controls:ShimmerLoadingControl Width="60" Height="20" CornerRadius="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <controls:ShimmerLoadingControl Width="200" Height="16" HorizontalAlignment="Left"/>
                        <controls:ShimmerLoadingControl Width="140" Height="12" HorizontalAlignment="Left"/>
                        <controls:ShimmerLoadingControl Width="60" Height="20" CornerRadius="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
  
                <!-- Best sellers list -->
                <ItemsControl ItemsSource="{Binding TopSellerItems}"
                    Margin="0,0,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="dashModels:DashboardTopSellerProduct">
                      <Border BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
                              BorderThickness="0,0,0,1"
                              Padding="0,0,0,12"
                              Margin="0,0,0,12">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
  
                          <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                            <TextBlock FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Margin="0,2,0,0"
                                       Text="{Binding SubInfo}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                            <!-- Revenue badge -->
                            <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="24"
                                    Padding="6,2"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Left">
                              <TextBlock FontSize="11"
                                  Foreground="{StaticResource GreenBrush}"
                                         Text="{Binding RevenueBadgeText}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                            </Border>
                          </StackPanel>
  
                          <StackPanel Grid.Column="1"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding QuantitySoldDisplay}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Right" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                            <TextBlock Text="sold"
                                       FontSize="10"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Right" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
  
            <!-- Low Stock Alerts -->
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0"
                      Orientation="Horizontal"
                      Spacing="8">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                        Text="&#xE7BA;"
                        FontSize="14"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        VerticalAlignment="Center"/>
                    <TextBlock Text="Low Stock Alerts"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                  </StackPanel>
                  <HyperlinkButton Grid.Column="1"
                                   Content="Restock All"
                                   FontSize="12"
                                   Foreground="{StaticResource PurpleBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"
                                   Padding="0"
                                   Click="RestockAll_Click"/>
                </Grid>
  
                <!-- Table header -->
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="60"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0"
                      Text="PRODUCT"
                      FontSize="10"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      FontWeight="SemiBold"
                      CharacterSpacing="40" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                  <TextBlock Grid.Column="1"
                      Text="STOCK"
                      FontSize="10"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      FontWeight="SemiBold"
                      HorizontalAlignment="Center"
                      CharacterSpacing="40" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                  <TextBlock Grid.Column="2"
                      Text="ACTION"
                      FontSize="10"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      FontWeight="SemiBold"
                      HorizontalAlignment="Right"
                      CharacterSpacing="40" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                </Grid>
  
                <ItemsControl ItemsSource="{Binding LowStockItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="dashModels:DashboardLowStockProduct">
                      <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="60"/>
                          <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
  
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Name}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
  
                        <!-- Stock badge -->
                        <Border Grid.Column="1"
                                Background="#FEF2F2"
                                CornerRadius="24"
                                Padding="6,3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                          <TextBlock FontSize="11"
                              Foreground="#DC2626"
                              HorizontalAlignment="Center">
                            <Run Text="{Binding StockQuantity}"/>
                            <Run Text=" left"/>
                          </TextBlock>
                        </Border>
  
                        <!-- Order button -->
                        <HyperlinkButton Grid.Column="2"
                                        Content="Order"
                                        FontSize="11"
                                        Foreground="{StaticResource PurpleBrush}"
                                        FontWeight="SemiBold"
                                        FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        Click="RestockAll_Click"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
  
          </StackPanel>
  
          <!-- ── RIGHT COLUMN ── -->
          <StackPanel x:Name="RightContentPanel"
            Grid.Column="2"
              Spacing="16">
  
            <!-- Recent Orders -->
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0"
                      Orientation="Horizontal"
                      Spacing="8">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                        Text="&#xE7BC;"
                        FontSize="14"
                        Foreground="{StaticResource PurpleBrush}"
                        VerticalAlignment="Center"/>
                    <TextBlock Text="Recent Orders"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                  </StackPanel>
                  <HyperlinkButton Grid.Column="1"
                                   Content="View All Orders"
                                   FontSize="12"
                                   Foreground="{StaticResource PurpleBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"
                                   Padding="0"
                                   Click="ViewAllOrders_Click"/>
                </Grid>
  
                <!-- Skeleton loading state for Recent Orders -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="16">
                    <StackPanel Spacing="8">
                        <controls:ShimmerLoadingControl Width="150" Height="14" HorizontalAlignment="Left"/>
                        <controls:ShimmerLoadingControl Width="220" Height="12" HorizontalAlignment="Left"/>
                        <controls:ShimmerLoadingControl Width="70" Height="18" CornerRadius="9" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <controls:ShimmerLoadingControl Width="130" Height="14" HorizontalAlignment="Left"/>
                        <controls:ShimmerLoadingControl Width="200" Height="12" HorizontalAlignment="Left"/>
                        <controls:ShimmerLoadingControl Width="70" Height="18" CornerRadius="9" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <controls:ShimmerLoadingControl Width="160" Height="14" HorizontalAlignment="Left"/>
                        <controls:ShimmerLoadingControl Width="210" Height="12" HorizontalAlignment="Left"/>
                        <controls:ShimmerLoadingControl Width="70" Height="18" CornerRadius="9" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding RecentOrders}"
                              Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="dashModels:DashboardRecentOrder">
                      <Border BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
                              BorderThickness="0,0,0,1"
                              Padding="0,0,0,14"
                              Margin="0,0,0,14">
                        <StackPanel Spacing="6">
                          <!-- Customer & Amount row -->
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding CustomerName}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TotalPriceDisplay}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Right" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                          </Grid>
  
                          <!-- Order meta -->
                          <TextBlock FontSize="11"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                            <Run Text="Order #"/>
                            <Run Text="{Binding IdDisplay}"/>
                            <Run Text=" • "/>
                            <Run Text="{Binding TimeAgo}"/>
                          </TextBlock>
  
                          <!-- Status badge -->
                          <Border CornerRadius="24"
                                  Padding="8,3"
                                  HorizontalAlignment="Left"
                                  Background="{Binding StatusBadgeBg, Converter={StaticResource HexToBrushConverter}}">
                            <TextBlock Text="{Binding Status}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding StatusBadgeFg, Converter={StaticResource HexToBrushConverter}}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                          </Border>
  
                          <!-- Item line -->
                          <TextBlock Text="{Binding FirstItemLine}"
                                     FontSize="11"
                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                     TextTrimming="CharacterEllipsis" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
  
          </StackPanel>
        </Grid>
  
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>

