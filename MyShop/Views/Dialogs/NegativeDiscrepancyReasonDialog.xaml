<ContentDialog
    x:Class="MyShop.Views.Dialogs.NegativeDiscrepancyReasonDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:MyShop.Converters"
    x:Name="DialogRoot"
    MinWidth="500"
    CornerRadius="12">

    <ContentDialog.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </ContentDialog.Resources>

    <StackPanel Spacing="22" Margin="4">
        <StackPanel Spacing="14">
            <Border Background="#FEF3C7"
                    CornerRadius="24"
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Left">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           Text="&#xE7BA;"
                           FontSize="20"
                           Foreground="#B45309"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Spacing="6">
                <TextBlock Text="Negative Cash Discrepancy"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorPrimary}"/>
                <TextBlock Text="{x:Bind DiscrepancyMessage, Mode=OneWay}"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondary}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <Border Background="{ThemeResource ControlStrokeColorDefaultBrush}" Height="1" Margin="-4,0,-4,0"/>

        <StackPanel Spacing="10">
            <TextBlock Text="Reason for shortage"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimary}"/>
            <TextBox x:Name="ReasonTextBox"
                     Text="{x:Bind Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Explain why actual cash is lower than expected cash..."
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="140"
                     CornerRadius="8"
                     Padding="12"
                     Background="{ThemeResource ControlFillColorDefaultBrush}"
                     BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"/>
            <TextBlock Text="{x:Bind ValidationMessage, Mode=OneWay}"
                       FontSize="12"
                       Foreground="#DC2626"
                       Visibility="{x:Bind ValidationMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <Border Background="{ThemeResource ControlStrokeColorDefaultBrush}" Height="1" Margin="-4,0,-4,0"/>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Click="CancelBtn_Click"
                    Background="Transparent"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12">
                <TextBlock Text="Cancel"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimary}"
                           HorizontalAlignment="Center"/>
            </Button>

            <Button Grid.Column="1"
                    Click="ConfirmBtn_Click"
                    Background="#B45309"
                    BorderThickness="0"
                    CornerRadius="8"
                    Padding="14,12">
                <TextBlock Text="Submit Report"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </Button>
        </Grid>
    </StackPanel>
</ContentDialog>
