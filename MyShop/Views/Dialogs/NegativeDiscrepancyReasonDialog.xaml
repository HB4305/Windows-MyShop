<ContentDialog
    x:Class="MyShop.Views.Dialogs.NegativeDiscrepancyReasonDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:MyShop.Converters"
    x:Name="DialogRoot"
    Width="500"
    CornerRadius="12">

    <ContentDialog.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </ContentDialog.Resources>

    <StackPanel Spacing="22" Margin="4">
        <StackPanel Spacing="14">
            <Border Background="#FEF3C7"
                    CornerRadius="24"
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Left">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           Text="&#xE7BA;"
                           FontSize="20"
                           Foreground="#B45309"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Spacing="6">
                <TextBlock Text="Negative Cash Discrepancy"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="{x:Bind DiscrepancyMessage, Mode=OneWay}"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <Border Background="{ThemeResource ControlStrokeColorDefaultBrush}" Height="1" Margin="-4,0,-4,0"/>

        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Reason for shortage"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                <TextBlock Text="*" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            </StackPanel>
            <Border x:Name="ReasonWrapper"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="24">
                <TextBox x:Name="ReasonTextBox"
                         Text="{x:Bind Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Explain why actual cash is lower than expected cash..."
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="140"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="16,10"
                         GotFocus="TextBox_GotFocus"
                         LostFocus="TextBox_LostFocus">
                    <TextBox.Resources>
                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    </TextBox.Resources>
                </TextBox>
            </Border>
            <Border Visibility="{x:Bind ValidationMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" Padding="0,2,0,0">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA39;" FontSize="10" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ValidationMessage, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Background="{ThemeResource ControlStrokeColorDefaultBrush}" Height="1" Margin="-4,0,-4,0"/>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Click="CancelBtn_Click"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="14,10"
                    Style="{StaticResource ColorPreservingButtonStyle}">
                <TextBlock Text="Cancel"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           HorizontalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            </Button>

            <Button Grid.Column="1"
                    Click="ConfirmBtn_Click"
                    HorizontalAlignment="Stretch"
                    Background="#B45309"
                    BorderThickness="0"
                    CornerRadius="24"
                    Padding="14,10"
                    Style="{StaticResource ColorPreservingButtonStyle}">
                <TextBlock Text="Submit Report"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            </Button>
        </Grid>
    </StackPanel>
</ContentDialog>
