<ContentDialog
    x:Class="MyShop.Views.Dialogs.AddEditCustomerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:MyShop.Converters"
    mc:Ignorable="d"
    x:Name="DialogRoot"
    Width="480"
    CornerRadius="24"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <!-- Use ThemeResource for background to support dark mode, or force light if requested by branding -->
        <SolidColorBrush x:Key="ContentDialogBackground" Color="{ThemeResource ApplicationPageBackgroundThemeBrush}"/>

        <Style x:Key="DetailFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="24" Margin="4,4,4,4" Width="460">
        <!-- Header -->
        <StackPanel Spacing="16">
            <Border Background="{ThemeResource AppAccentBrushLow}"
                    CornerRadius="24"
                    Width="48" Height="48"
                    HorizontalAlignment="Left">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           Text="&#xE77B;"
                           FontSize="20"
                           Foreground="{ThemeResource AppAccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Spacing="6">
                <TextBlock x:Name="FormTitle"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                <TextBlock x:Name="FormSubtitle"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Manage customer contact information." FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            </StackPanel>
        </StackPanel>

        <Border Background="{ThemeResource ControlStrokeColorDefaultBrush}" Height="1" Margin="-4,0,-4,0"/>

        <!-- Form Fields -->
        <StackPanel Spacing="20">
            <!-- Name -->
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Full name" Style="{StaticResource DetailFieldLabelStyle}"/>
                    <TextBlock Text="*" Style="{StaticResource DetailFieldLabelStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                </StackPanel>
                <Border x:Name="NameWrapper"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="24">
                    <TextBox x:Name="NameTextBox"
                             PlaceholderText="e.g. John Doe"
                             MaxLength="255"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="16,10"
                             GotFocus="TextBox_GotFocus"
                             LostFocus="TextBox_LostFocus"
                             Text="{x:Bind CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Resources>
                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>
                </Border>
                <Border Visibility="{x:Bind NameValidationMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" Padding="0,2,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA39;" FontSize="10" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind NameValidationMessage, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Phone -->
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Phone number" Style="{StaticResource DetailFieldLabelStyle}"/>
                    <TextBlock Text="*" Style="{StaticResource DetailFieldLabelStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                </StackPanel>
                <Border x:Name="PhoneWrapper"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="24">
                    <TextBox x:Name="PhoneTextBox"
                             PlaceholderText="e.g. 0912345678"
                             MaxLength="20"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="16,10"
                             GotFocus="TextBox_GotFocus"
                             LostFocus="TextBox_LostFocus"
                             Text="{x:Bind CustomerPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Resources>
                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>
                </Border>
                <Border Visibility="{x:Bind PhoneValidationMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" Padding="0,2,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA39;" FontSize="10" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind PhoneValidationMessage, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Address -->
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Address" Style="{StaticResource DetailFieldLabelStyle}"/>
                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="24" Padding="6,1">
                        <TextBlock Text="Optional" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                    </Border>
                </StackPanel>
                <Border x:Name="AddressWrapper"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="24">
                    <TextBox x:Name="AddressTextBox"
                             PlaceholderText="Enter shipping address..."
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MinHeight="90"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="16,10"
                             GotFocus="TextBox_GotFocus"
                             LostFocus="TextBox_LostFocus"
                             Text="{x:Bind CustomerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Resources>
                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>
                </Border>
            </StackPanel>
        </StackPanel>

        <Border Background="{ThemeResource ControlStrokeColorDefaultBrush}" Height="1" Margin="-4,0,-4,0"/>

        <!-- Buttons -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Click="CancelBtn_Click" HorizontalAlignment="Stretch"
                    Background="Transparent" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="24" Padding="14,12"
                  Style="{StaticResource ColorPreservingButtonStyle}">
                <TextBlock Text="Cancel" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            </Button>

            <Button Grid.Column="1" Click="SaveBtn_Click" HorizontalAlignment="Stretch"
                    Background="{ThemeResource AppAccentBrush}" BorderThickness="0" CornerRadius="24" Padding="14,12"
                  Style="{StaticResource ColorPreservingButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SaveBtnText" Text="Save" FontSize="14" FontWeight="SemiBold" Foreground="White" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</ContentDialog>

