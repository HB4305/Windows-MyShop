<ContentDialog
    x:Class="MyShop.Views.Dialogs.SupplierDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:MyShop.Converters"
    x:Name="DialogRoot"
    Width="480"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </ContentDialog.Resources>

    <StackPanel Spacing="24" Margin="4" Width="460">
        <!-- Header -->
        <StackPanel Spacing="16">
            <Border Background="{ThemeResource AppAccentBrushLow}"
                    CornerRadius="24"
                    Width="48" Height="48"
                    HorizontalAlignment="Left">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           Text="&#xE8B8;"
                           FontSize="20"
                           Foreground="{ThemeResource AppAccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Spacing="6">
                <TextBlock x:Name="DialogTitleText"
                           Text="Edit Supplier"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                <TextBlock Text="Update the contact and business details of this supplier."
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            </StackPanel>
        </StackPanel>

        <Border Background="{ThemeResource ControlStrokeColorDefaultBrush}" Height="1" Margin="-4,0,-4,0"/>

        <!-- Form Fields -->
        <StackPanel Spacing="20">
            <!-- Errors removed here to be inline -->

            <!-- Name -->
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Supplier name" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                    <TextBlock Text="*" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                </StackPanel>
                <Border x:Name="NameWrapper"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="24">
                    <TextBox x:Name="NameTextBox"
                             PlaceholderText="e.g. ABC Sports Co., Ltd."
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="16,10"
                             GotFocus="TextBox_GotFocus"
                             LostFocus="TextBox_LostFocus">
                        <TextBox.Resources>
                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>
                </Border>
                <Border Visibility="{x:Bind NameErrorText.Visibility, Mode=OneWay}" Padding="0,2,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA39;" FontSize="10" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NameErrorText" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Phone -->
            <StackPanel Spacing="6">
                <TextBlock Text="Phone number" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                <Border x:Name="PhoneWrapper"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="24">
                    <TextBox x:Name="PhoneTextBox"
                             PlaceholderText="e.g. 0912345678"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="16,10"
                             GotFocus="TextBox_GotFocus"
                             LostFocus="TextBox_LostFocus">
                        <TextBox.Resources>
                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>
                </Border>
            </StackPanel>

            <!-- Type -->
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Type" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="24" Padding="6,1">
                        <TextBlock Text="Optional" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                    </Border>
                </StackPanel>
                <Border x:Name="TypeWrapper"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="24">
                    <TextBox x:Name="TypeTextBox"
                             PlaceholderText="e.g. Wholesale, Retail"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="16,10"
                             GotFocus="TextBox_GotFocus"
                             LostFocus="TextBox_LostFocus">
                        <TextBox.Resources>
                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>
                </Border>
            </StackPanel>
        </StackPanel>

        <Border Background="{ThemeResource ControlStrokeColorDefaultBrush}" Height="1" Margin="-4,0,-4,0"/>

        <!-- Buttons -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="CancelBtn" Click="CancelBtn_Click" HorizontalAlignment="Stretch"
                    Background="Transparent" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="24" Padding="14,10"
                    Style="{StaticResource ColorPreservingButtonStyle}">
                <TextBlock Text="Cancel" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            </Button>

            <Button Grid.Column="1" x:Name="SaveBtn" Click="SaveBtn_Click" HorizontalAlignment="Stretch"
                    Background="{ThemeResource AppAccentBrush}" BorderThickness="0" CornerRadius="24" Padding="14,10"
                    Style="{StaticResource ColorPreservingButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="Save Changes" FontSize="14" FontWeight="SemiBold" Foreground="White" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</ContentDialog>

