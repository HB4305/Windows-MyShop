<ContentDialog
    x:Class="MyShop.Views.Dialogs.AddEditStaffDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:MyShop.Converters"
    x:Name="DialogRoot"
    Width="480"
    CornerRadius="20"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </ContentDialog.Resources>

    <StackPanel Spacing="24" Margin="4" Width="460">
        <StackPanel Spacing="16">
            <Border Background="{ThemeResource AppAccentBrushLow}"
                    CornerRadius="24"
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Left">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           Text="&#xE716;"
                           FontSize="20"
                           Foreground="{ThemeResource AppAccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Spacing="6">
                <TextBlock x:Name="FormTitle"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorPrimary}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                <TextBlock x:Name="FormSubtitle"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondary}"
                           TextWrapping="Wrap" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            </StackPanel>
        </StackPanel>

        <Border Background="{ThemeResource ControlStrokeColorDefaultBrush}" Height="1" Margin="-4,0,-4,0"/>

        <StackPanel Spacing="18">
            <StackPanel Spacing="8">
                <TextBlock Text="Email"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimary}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                <TextBox Text="{x:Bind Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          PlaceholderText="staff@myshop.com"
                          CornerRadius="20"
                          Padding="12,10"
                          Background="{ThemeResource ControlFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                <TextBlock Text="{x:Bind EmailValidationMessage, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Visibility="{x:Bind EmailValidationMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Role"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimary}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                <Border CornerRadius="20"
                        Padding="12,10"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <TextBlock Text="SALE"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimary}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Password"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimary}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                <PasswordBox x:Name="PasswordInput"
                              PlaceholderText="At least 6 characters"
                              PasswordChanged="PasswordInput_PasswordChanged"
                              CornerRadius="20"
                              Padding="12,10"
                              Background="{ThemeResource ControlFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                <TextBlock x:Name="PasswordHintText"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondary}"
                           TextWrapping="Wrap" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                <TextBlock Text="{x:Bind PasswordValidationMessage, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Visibility="{x:Bind PasswordValidationMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            </StackPanel>
        </StackPanel>

        <Border Background="{ThemeResource ControlStrokeColorDefaultBrush}" Height="1" Margin="-4,0,-4,0"/>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="CancelBtn"
                    Click="CancelBtn_Click"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="14,10"
                    Style="{StaticResource ColorPreservingButtonStyle}">
                <TextBlock Text="Cancel"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimary}"
                           HorizontalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            </Button>

            <Button Grid.Column="1"
                    x:Name="SaveBtn"
                    Click="SaveBtn_Click"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource AppAccentBrush}"
                    BorderThickness="0"
                    CornerRadius="20"
                    Padding="14,10"
                    Style="{StaticResource ColorPreservingButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE73E;"
                               FontSize="14"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="SaveBtnText"
                               Text="Save"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</ContentDialog>
