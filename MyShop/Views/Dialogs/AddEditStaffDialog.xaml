<ContentDialog
    x:Class="MyShop.Views.Dialogs.AddEditStaffDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:MyShop.Converters"
    x:Name="DialogRoot"
    MinWidth="460"
    CornerRadius="12">

    <ContentDialog.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </ContentDialog.Resources>

    <StackPanel Spacing="24" Margin="4">
        <StackPanel Spacing="16">
            <Border Background="#F3F0FF"
                    CornerRadius="24"
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Left">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           Text="&#xE716;"
                           FontSize="20"
                           Foreground="#7C3AED"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Spacing="6">
                <TextBlock x:Name="FormTitle"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorPrimary}"/>
                <TextBlock x:Name="FormSubtitle"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondary}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <Border Background="{ThemeResource ControlStrokeColorDefaultBrush}" Height="1" Margin="-4,0,-4,0"/>

        <StackPanel Spacing="18">
            <StackPanel Spacing="8">
                <TextBlock Text="Email"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimary}"/>
                <TextBox Text="{x:Bind Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="staff@myshop.com"
                         CornerRadius="8"
                         Padding="12"
                         Background="{ThemeResource ControlFillColorDefaultBrush}"
                         BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                <TextBlock Text="{x:Bind EmailValidationMessage, Mode=OneWay}"
                           FontSize="12"
                           Foreground="#DC2626"
                           Visibility="{x:Bind EmailValidationMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Role"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimary}"/>
                <Border CornerRadius="8"
                        Padding="12"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <TextBlock Text="SALE"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimary}"/>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Password"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimary}"/>
                <PasswordBox x:Name="PasswordInput"
                             PlaceholderText="At least 6 characters"
                             PasswordChanged="PasswordInput_PasswordChanged"
                             CornerRadius="8"
                             Padding="12"
                             Background="{ThemeResource ControlFillColorDefaultBrush}"
                             BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                <TextBlock x:Name="PasswordHintText"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondary}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{x:Bind PasswordValidationMessage, Mode=OneWay}"
                           FontSize="12"
                           Foreground="#DC2626"
                           Visibility="{x:Bind PasswordValidationMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>
        </StackPanel>

        <Border Background="{ThemeResource ControlStrokeColorDefaultBrush}" Height="1" Margin="-4,0,-4,0"/>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Click="CancelBtn_Click"
                    Background="Transparent"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12">
                <TextBlock Text="Cancel"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimary}"
                           HorizontalAlignment="Center"/>
            </Button>

            <Button Grid.Column="1"
                    Click="SaveBtn_Click"
                    Background="#7C3AED"
                    BorderThickness="0"
                    CornerRadius="8"
                    Padding="14,12">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE73E;"
                               FontSize="14"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="SaveBtnText"
                               Text="Save"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</ContentDialog>
