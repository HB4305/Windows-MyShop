<ContentDialog
    x:Class="MyShop.Views.Dialogs.AddEditStaffDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:MyShop.Converters"
    x:Name="DialogRoot"
    Width="480"
    CornerRadius="24"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <Style x:Key="DetailFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="24" Margin="4" Width="460">
        <StackPanel Spacing="16">
            <Border Background="{ThemeResource AppAccentBrushLow}"
                    CornerRadius="24"
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Left">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           Text="&#xE716;"
                           FontSize="20"
                           Foreground="{ThemeResource AppAccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Spacing="6">
                <TextBlock x:Name="FormTitle"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                <TextBlock x:Name="FormSubtitle"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            </StackPanel>
        </StackPanel>

        <Border Background="{ThemeResource ControlStrokeColorDefaultBrush}" Height="1" Margin="-4,0,-4,0"/>

        <StackPanel Spacing="18">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Email address"
                               Style="{StaticResource DetailFieldLabelStyle}"/>
                    <TextBlock Text="*" Style="{StaticResource DetailFieldLabelStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                </StackPanel>
                <Border x:Name="EmailWrapper"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="24">
                    <TextBox x:Name="EmailTextBox"
                             Text="{x:Bind Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="staff@myshop.com"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="16,10"
                             GotFocus="TextBox_GotFocus"
                             LostFocus="TextBox_LostFocus">
                        <TextBox.Resources>
                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>
                </Border>
                <Border Visibility="{x:Bind EmailValidationMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" Padding="0,2,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA39;" FontSize="10" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind EmailValidationMessage, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Access role"
                           Style="{StaticResource DetailFieldLabelStyle}"/>
                <Border CornerRadius="24"
                        Padding="16,10"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <TextBlock Text="SALE"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                </Border>
            </StackPanel>

            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Password"
                               Style="{StaticResource DetailFieldLabelStyle}"/>
                    <TextBlock Text="*" Style="{StaticResource DetailFieldLabelStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                </StackPanel>
                <Border x:Name="PasswordWrapper"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="24">
                    <PasswordBox x:Name="PasswordInput"
                                 PlaceholderText="At least 6 characters"
                                 PasswordChanged="PasswordInput_PasswordChanged"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="16,10"
                                 GotFocus="PasswordBox_GotFocus"
                                 LostFocus="PasswordBox_LostFocus">
                        <PasswordBox.Resources>
                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </PasswordBox.Resources>
                    </PasswordBox>
                </Border>
                <TextBlock x:Name="PasswordHintText"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                <Border Visibility="{x:Bind PasswordValidationMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" Padding="0,2,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA39;" FontSize="10" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind PasswordValidationMessage, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <Border Background="{ThemeResource ControlStrokeColorDefaultBrush}" Height="1" Margin="-4,0,-4,0"/>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="CancelBtn"
                    Click="CancelBtn_Click"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="14,10"
                    Style="{StaticResource ColorPreservingButtonStyle}">
                <TextBlock Text="Cancel"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           HorizontalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            </Button>

            <Button Grid.Column="1"
                    x:Name="SaveBtn"
                    Click="SaveBtn_Click"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource AppAccentBrush}"
                    BorderThickness="0"
                    CornerRadius="24"
                    Padding="14,10"
                    Style="{StaticResource ColorPreservingButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE73E;"
                               FontSize="14"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="SaveBtnText"
                               Text="Save"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</ContentDialog>

