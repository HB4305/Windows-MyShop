<ContentDialog x:Class="MyShop.Views.Dialogs.CreateOrderDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:m="using:MyShop.Models"
               xmlns:controls="using:MyShop.Controls"
               x:Name="DialogRoot"
               MinWidth="900"
               MaxWidth="1200"
               CornerRadius="24"
               Style="{StaticResource DefaultContentDialogStyle}">

  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
    <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="Transparent"/>
    
    <Style x:Key="HeaderStyle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,16,0,8"/>
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Setter Property="FontSize" Value="16"/>
    </Style>

    <Style x:Key="CreateOrderTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ModernSearchTextBoxStyle}">
      <Setter Property="CornerRadius" Value="24"/>
    </Style>

    <Style x:Key="CreateOrderAutoSuggestBoxStyle" TargetType="AutoSuggestBox" BasedOn="{StaticResource ModernSearchAutoSuggestBoxStyle}">
      <Setter Property="CornerRadius" Value="24"/>
    </Style>

    <Style x:Key="CreateOrderComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="CornerRadius" Value="24"/>
      <Setter Property="Padding" Value="12,12"/>
      <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
      <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </ContentDialog.Resources>

  <StackPanel Spacing="20" Margin="4">
    <!-- Header -->
    <StackPanel Spacing="16">
      <Border Background="{ThemeResource AppAccentBrushLow}"
              CornerRadius="24"
              Width="48" Height="48"
              HorizontalAlignment="Left">
        <TextBlock FontFamily="Segoe MDL2 Assets"
                   Text="&#xE8A1;"
                   FontSize="20"
                   Foreground="{ThemeResource AppAccentBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
      </Border>

      <StackPanel Spacing="6">
        <TextBlock Text="Create New Order"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
        <TextBlock Text="Fill in customer details and select products for this order."
                   FontSize="14"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
      </StackPanel>
    </StackPanel>

    <Border Background="{ThemeResource ControlStrokeColorDefaultBrush}" Height="1" Margin="-4,0,-4,0"/>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" MaxHeight="600">
      <StackPanel Spacing="16" Padding="4,0,4,0" HorizontalAlignment="Stretch">
        <Grid Width="850" Height="1"/>
        
        <!-- Error Message (hidden, using inline validation instead) -->
        <!-- Error Message Banner Removed -->


        <Grid ColumnSpacing="24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Top row: Order type/payment (left) and Search (right) -->
          <Grid Grid.Row="0" Grid.Column="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="8">
              <TextBlock Style="{StaticResource HeaderStyle}" Margin="0">
                <Run Text="ORDER TYPE "/>
                <Run Text="*" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
              </TextBlock>
              <ComboBox x:Name="OrderTypeCombo"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource CreateOrderComboBoxStyle}"
                        SelectedIndex="0"
                        FontSize="14"
                        SelectionChanged="OrderTypeCombo_SelectionChanged"
                        GotFocus="Input_GotFocus"
                        LostFocus="Input_LostFocus">
                <ComboBoxItem Content="AtStore"/>
                <ComboBoxItem Content="Delivery"/>
              </ComboBox>
              <Border x:Name="OrderTypeErrorBorder" Visibility="Collapsed" Padding="4,2,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA39;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="OrderTypeErrorText" Text="" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8">
              <TextBlock Style="{StaticResource HeaderStyle}" Margin="0">
                <Run Text="PAYMENT METHOD "/>
                <Run Text="*" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
              </TextBlock>
              <ComboBox x:Name="PaymentMethodCombo"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource CreateOrderComboBoxStyle}"
                        FontSize="14"
                        ItemsSource="{x:Bind ViewModel.AvailablePaymentMethods, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.Order.PaymentMethod, Mode=TwoWay}"
                        GotFocus="Input_GotFocus"
                        LostFocus="Input_LostFocus"/>
              <Border x:Name="PaymentMethodErrorBorder" Visibility="Collapsed" Padding="4,2,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA39;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="PaymentMethodErrorText" Text="" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <!-- Top row right: Search placed next to order controls -->
          <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="ORDER ITEMS" Style="{StaticResource HeaderStyle}" Margin="0"/>
            <Border CornerRadius="24" 
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
              <AutoSuggestBox x:Name="ProductSearchBox"
                      Style="{StaticResource ModernSearchAutoSuggestBoxStyle}"
                      PlaceholderText="Search product by name..."
                      QueryIcon="Find"
                      TextChanged="ProductSearchBox_TextChanged"
                      SuggestionChosen="ProductSearchBox_SuggestionChosen"
                      DisplayMemberPath="Name"
                      TextMemberPath="Name"
                      GotFocus="Input_GotFocus"
                      LostFocus="Input_LostFocus"
                      Height="48"
                      VerticalContentAlignment="Center"
                      FontFamily="{StaticResource AppDefaultFontFamily}">
                <AutoSuggestBox.Resources>
                  <!-- Style the internal search button -->
                  <Style TargetType="Button" x:Key="AutoSuggestBoxQueryButtonStyle">
                    <Setter Property="Foreground" Value="{StaticResource AppPurpleBrush}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                  </Style>
                </AutoSuggestBox.Resources>
              </AutoSuggestBox>
            </Border>
            <Border x:Name="OrderItemsErrorBorder" Visibility="Collapsed" Padding="4,2,0,0">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA39;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="OrderItemsErrorText" Text="" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Main content row: left - customer info; right - selected items list -->
          <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8">
            <TextBlock Text="CUSTOMER INFORMATION" Style="{StaticResource HeaderStyle}" Margin="0"/>

            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Customer name" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                <TextBlock Text="*" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
              </StackPanel>
              <Border x:Name="CustomerNameWrapper"
                      Background="{ThemeResource ControlFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="24">
                <TextBox x:Name="CustomerNameBox"
                         PlaceholderText="e.g. John Doe"
                         Text="{x:Bind ViewModel.Order.CustomerName, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="16,10"
                         GotFocus="Input_GotFocus"
                         LostFocus="Input_LostFocus">
                  <TextBox.Resources>
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                  </TextBox.Resources>
                </TextBox>
              </Border>
              <Border x:Name="CustomerNameErrorBorder" Visibility="Collapsed" Padding="0,2,0,0">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA39;" FontSize="10" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="CustomerNameErrorText" Text="" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Phone number" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                <TextBlock Text="*" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
              </StackPanel>
              <Border x:Name="CustomerPhoneWrapper"
                      Background="{ThemeResource ControlFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="24">
                <controls:NumericTextBox x:Name="CustomerPhoneBox"
                         PlaceholderText="e.g. 0912345678"
                         Text="{x:Bind ViewModel.Order.CustomerPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         InputScope="TelephoneNumber"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="16,10"
                         GotFocus="Input_GotFocus"
                         LostFocus="Input_LostFocus">
                  <controls:NumericTextBox.Resources>
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                  </controls:NumericTextBox.Resources>
                </controls:NumericTextBox>
              </Border>
              <Border x:Name="CustomerPhoneErrorBorder" Visibility="Collapsed" Padding="0,2,0,0">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA39;" FontSize="10" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="CustomerPhoneErrorText" Text="" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="6" Visibility="{x:Bind CustomerAddressBox.Visibility, Mode=OneWay}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Shipping address" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                <TextBlock Text="*" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
              </StackPanel>
              <Border x:Name="CustomerAddressWrapper"
                      Background="{ThemeResource ControlFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="24">
                <TextBox x:Name="CustomerAddressBox"
                         PlaceholderText="Enter full address..."
                         Text="{x:Bind ViewModel.Order.ShippingAddress, Mode=TwoWay}"
                         Height="80"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Visibility="Visible"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="16,10"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         GotFocus="Input_GotFocus"
                         LostFocus="Input_LostFocus">
                  <TextBox.Resources>
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                  </TextBox.Resources>
                </TextBox>
              </Border>
              <Border x:Name="CustomerAddressErrorBorder" Visibility="Collapsed" Padding="0,2,0,0">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA39;" FontSize="10" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="CustomerAddressErrorText" Text="" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Row="1" Grid.Column="1" Spacing="12">
            <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="24"
                    Height="310"
                    Margin="0,4,0,0"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    VerticalAlignment="Top">
              <ListView x:Name="OrderLinesListView"
                        ItemsSource="{x:Bind ViewModel.OrderDetails}"
                        SelectionMode="None"
                        Height="270"
                        VerticalAlignment="Top"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollMode="Enabled"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="m:OrderDetail">
                    <Grid Margin="0,4" Padding="14,10">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>

                      <!-- Top Section -->
                      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ItemName}" FontWeight="SemiBold" FontSize="15" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="320" VerticalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                        <Border Background="{ThemeResource AppAccentBrushLow}" CornerRadius="24" Padding="10,2" VerticalAlignment="Center">
                          <TextBlock Text="{x:Bind StockStatusDisplay, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" FontWeight="SemiBold" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                        </Border>
                      </StackPanel>

                      <!-- Bottom Section -->
                      <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="80"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox ItemsSource="{x:Bind AvailableSizes, Mode=OneWay}"
                                  SelectedItem="{x:Bind SelectedSize, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  Style="{StaticResource CreateOrderComboBoxStyle}"
                                  PlaceholderText="Size"
                                  GotFocus="Input_GotFocus"
                                  LostFocus="Input_LostFocus"/>

                        <ComboBox Grid.Column="1" ItemsSource="{x:Bind AvailableColors, Mode=OneWay}"
                                  SelectedItem="{x:Bind SelectedColor, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  Style="{StaticResource CreateOrderComboBoxStyle}"
                                  PlaceholderText="Color"
                                  GotFocus="Input_GotFocus"
                                  LostFocus="Input_LostFocus"/>

                        <Border Grid.Column="2"
                                CornerRadius="24"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                          <controls:NumericTextBox Text="{x:Bind QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{x:Bind IsQuantityEnabled, Mode=OneWay}"
                                     TextChanged="Quantity_TextChanged"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="12,12"
                                     HorizontalAlignment="Stretch"
                                     MinHeight="40"
                                     GotFocus="Input_GotFocus"
                                     LostFocus="Input_LostFocus">
                            <controls:NumericTextBox.Resources>
                              <ResourceDictionary>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                              </ResourceDictionary>
                            </controls:NumericTextBox.Resources>
                          </controls:NumericTextBox>
                        </Border>

                        <TextBlock Grid.Column="3" Text="{x:Bind TotalPriceDisplay, Mode=OneWay}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="8,0" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>

                        <Button Grid.Column="4" Background="Transparent"
                                BorderThickness="0"
                                Click="RemoveItem_Click"
                                Tag="{x:Bind}"
                                Style="{StaticResource ColorPreservingButtonStyle}">
                          <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                        </Button>
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <Border Background="{ThemeResource ControlStrokeColorDefaultBrush}" Height="1" Margin="-4,0,-4,0"/>

    <!-- Totals & Footer Buttons -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="Total Amount:" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
        <TextBlock x:Name="TotalAmountTextBlock" Text="{x:Bind ViewModel.TotalAmountDisplay, Mode=OneWay}" FontWeight="Bold" FontSize="22" Foreground="{ThemeResource AppAccentBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
        <Button Content="Cancel" Click="CancelButton_Click" MinWidth="120"
                Background="Transparent" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="24" Padding="20,10"
                Style="{StaticResource ColorPreservingButtonStyle}"/>
        <Button Content="Create Order" Click="CreateOrderButton_Click" MinWidth="160"
                Background="{StaticResource AppPurpleBrush}" Foreground="White" BorderThickness="0" CornerRadius="24" Padding="20,10"
                Style="{StaticResource ColorPreservingButtonStyle}">
        </Button>
      </StackPanel>
    </Grid>
  </StackPanel>
</ContentDialog>

