<ContentDialog x:Class="MyShop.Views.Dialogs.CreateOrderDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:m="using:MyShop.Models"
               x:Name="DialogRoot"
               MinWidth="900"
               MaxWidth="1200"
               CornerRadius="20"
               Style="{StaticResource DefaultContentDialogStyle}">

  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
    <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="Transparent"/>
    
    <Style x:Key="HeaderStyle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,16,0,8"/>
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondary}"/>
      <Setter Property="FontSize" Value="16"/>
    </Style>
  </ContentDialog.Resources>

  <StackPanel Spacing="20" Margin="4">
    <!-- Header -->
    <StackPanel Spacing="16">
      <Border Background="{ThemeResource AppAccentBrushLow}"
              CornerRadius="24"
              Width="48" Height="48"
              HorizontalAlignment="Left">
        <TextBlock FontFamily="Segoe MDL2 Assets"
                   Text="&#xE8A1;"
                   FontSize="20"
                   Foreground="{ThemeResource AppAccentBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
      </Border>

      <StackPanel Spacing="6">
        <TextBlock Text="Create New Order"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{ThemeResource TextFillColorPrimary}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
        <TextBlock Text="Fill in customer details and select products for this order."
                   FontSize="14"
                   Foreground="{ThemeResource TextFillColorSecondary}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
      </StackPanel>
    </StackPanel>

    <Border Background="{ThemeResource ControlStrokeColorDefaultBrush}" Height="1" Margin="-4,0,-4,0"/>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" MaxHeight="600">
      <StackPanel Spacing="16" Padding="4,0,4,0" HorizontalAlignment="Stretch">
        <Grid Width="850" Height="1"/>
        
        <!-- Error Message -->
        <Border x:Name="ErrorBorder" Visibility="Collapsed" 
                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" 
                CornerRadius="8" Padding="12,8">
          <TextBlock x:Name="ErrorTextBlock"
                     Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                     FontSize="13"
                     TextWrapping="Wrap" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
        </Border>

        <Grid ColumnSpacing="24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Left Column: Order & Customer Info -->
          <StackPanel Spacing="16">
            <!-- Order Type -->
            <StackPanel Spacing="8">
              <TextBlock Text="ORDER TYPE" Style="{StaticResource HeaderStyle}" Margin="0"/>
              <ComboBox x:Name="OrderTypeCombo"
                        HorizontalAlignment="Stretch"
                        CornerRadius="20"
                        SelectedIndex="0"
                        FontSize="14"
                        SelectionChanged="OrderTypeCombo_SelectionChanged">
                <ComboBoxItem Content="AtStore"/>
                <ComboBoxItem Content="Delivery"/>
              </ComboBox>
            </StackPanel>

            <!-- Customer Info -->
            <StackPanel Spacing="8">
              <TextBlock Text="CUSTOMER INFORMATION" Style="{StaticResource HeaderStyle}" Margin="0"/>
              
              <TextBox x:Name="CustomerNameBox"
                       Header="Customer Name *"
                       PlaceholderText="e.g. John Doe"
                       Text="{x:Bind ViewModel.Order.CustomerName, Mode=TwoWay}"
                       CornerRadius="20"
                       Background="{ThemeResource ControlFillColorDefaultBrush}"/>

              <TextBox x:Name="CustomerPhoneBox"
                       Header="Phone Number"
                       PlaceholderText="e.g. 0912345678"
                       Text="{x:Bind ViewModel.Order.CustomerPhone, Mode=TwoWay}"
                       InputScope="TelephoneNumber"
                       CornerRadius="20"
                       Background="{ThemeResource ControlFillColorDefaultBrush}"/>

              <TextBox x:Name="CustomerAddressBox"
                       Header="Shipping Address *"
                       PlaceholderText="Enter full address..."
                       Text="{x:Bind ViewModel.Order.ShippingAddress, Mode=TwoWay}"
                       CornerRadius="20"
                       MinHeight="80"
                       TextWrapping="Wrap"
                       AcceptsReturn="True"
                       Visibility="Collapsed"
                       Background="{ThemeResource ControlFillColorDefaultBrush}"/>
            </StackPanel>
          </StackPanel>

          <!-- Right Column: Product Search & Items -->
          <StackPanel Grid.Column="1" Spacing="16">
            <TextBlock Text="ORDER ITEMS" Style="{StaticResource HeaderStyle}" Margin="0"/>

            <!-- Product Search -->
            <AutoSuggestBox x:Name="ProductSearchBox"
                            PlaceholderText="Search product by name..."
                            QueryIcon="Find"
                            TextChanged="ProductSearchBox_TextChanged"
                            SuggestionChosen="ProductSearchBox_SuggestionChosen"
                            DisplayMemberPath="Name"
                            TextMemberPath="Name"
                            CornerRadius="20"/>

            <!-- Selected Items List -->
            <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    MinHeight="150"
                    Background="{ThemeResource ControlFillColorDefaultBrush}">
              <ListView x:Name="OrderLinesListView"
                        ItemsSource="{x:Bind ViewModel.OrderDetails}"
                        SelectionMode="None"
                        MaxHeight="350">
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="m:OrderDetail">
                    <Grid Margin="0,4" Padding="12,8">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>

                      <!-- Top Section -->
                      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ItemName}" FontWeight="SemiBold" FontSize="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="300" VerticalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                        <TextBlock Text="{x:Bind UnitPrice, Converter={StaticResource CurrencyConverter}}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondary}" VerticalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                        <Border Background="{ThemeResource AppAccentBrushLow}" CornerRadius="20" Padding="8,2" VerticalAlignment="Center">
                          <TextBlock Text="{x:Bind StockStatusDisplay, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" FontWeight="SemiBold" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                        </Border>
                      </StackPanel>

                      <!-- Bottom Section -->
                      <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="80"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox ItemsSource="{x:Bind AvailableSizes, Mode=OneWay}"
                                  SelectedItem="{x:Bind SelectedSize, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  CornerRadius="20"
                                  PlaceholderText="Size"/>

                        <ComboBox Grid.Column="1" ItemsSource="{x:Bind AvailableColors, Mode=OneWay}"
                                  SelectedItem="{x:Bind SelectedColor, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  CornerRadius="20"
                                  PlaceholderText="Color"/>

                        <NumberBox Grid.Column="2" Value="{x:Bind Quantity, Mode=TwoWay}"
                                   Minimum="1" Maximum="{x:Bind MaxQuantity, Mode=OneWay}"
                                   IsEnabled="{x:Bind IsQuantityEnabled, Mode=OneWay}"
                                   SpinButtonPlacementMode="Compact"
                                   ValueChanged="Quantity_ValueChanged"
                                   CornerRadius="20"
                                   HorizontalAlignment="Stretch"/>

                        <TextBlock Grid.Column="3" Text="{x:Bind TotalPriceDisplay, Mode=OneWay}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="8,0" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>

                        <Button Grid.Column="4" Background="Transparent"
                                BorderThickness="0"
                                Click="RemoveItem_Click"
                                Tag="{x:Bind}"
                                Style="{StaticResource ColorPreservingButtonStyle}">
                          <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                        </Button>
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <Border Background="{ThemeResource ControlStrokeColorDefaultBrush}" Height="1" Margin="-4,0,-4,0"/>

    <!-- Totals & Footer Buttons -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="Total Amount:" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
        <TextBlock x:Name="TotalAmountTextBlock" Text="{x:Bind ViewModel.TotalAmountDisplay, Mode=OneWay}" FontWeight="Bold" FontSize="22" Foreground="{ThemeResource AppAccentBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
        <Button Content="Cancel" Click="CancelButton_Click" MinWidth="120"
                Background="Transparent" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="20" Padding="20,10"
                Style="{StaticResource ColorPreservingButtonStyle}"/>
        <Button Content="Create Order" Click="CreateOrderButton_Click" MinWidth="160"
                Background="{ThemeResource AppAccentBrush}" BorderThickness="0" CornerRadius="20" Padding="20,10"
                Style="{StaticResource ColorPreservingButtonStyle}">
          <Button.Resources>
            <SolidColorBrush x:Key="ButtonForeground" Color="White"/>
          </Button.Resources>
        </Button>
      </StackPanel>
    </Grid>
  </StackPanel>
</ContentDialog>
