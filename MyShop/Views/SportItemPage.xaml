<Page x:Class="MyShop.Views.SportItemPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:MyShop.Models"
      xmlns:conv="using:MyShop.Converters"
      xmlns:controls="using:MyShop.Controls"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Page.Resources>
    <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
    <conv:FirstImageConverter x:Key="FirstImageConverter"/>
    <conv:CurrencyFormatter x:Key="CurrencyFormatter"/>
    <conv:SportItemStockPercentConverter x:Key="SportItemStockPercentConverter"/>
    <conv:SportItemStockBarForegroundConverter x:Key="SportItemStockBarForegroundConverter"/>
    <conv:SportItemStatusTextConverter x:Key="SportItemStatusTextConverter"/>
    <conv:SportItemStatusBadgeBackgroundConverter x:Key="SportItemStatusBadgeBackgroundConverter"/>
    <conv:SportItemStatusBadgeForegroundConverter x:Key="SportItemStatusBadgeForegroundConverter"/>

    <SolidColorBrush x:Key="AppPurpleBrush" Color="#8B52FF"/>
    <SolidColorBrush x:Key="PurpleLightBrush" Color="#8B52FF" Opacity="0.12"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626"/>

    <Style x:Key="BulkImportButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimary}"/>
      <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinHeight" Value="48"/>
      <Setter Property="Style" Value="{StaticResource ColorPreservingButtonStyle}"/>
    </Style>

    <Style x:Key="FilterPanelCardStyle" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
      <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Padding" Value="18,16"/>
      <Setter Property="MinHeight" Value="200"/>
    </Style>

    <!-- Pagination Button Styles -->
    <Style x:Key="PageBtn" TargetType="Button">
      <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimary}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
    </Style>

    <Style x:Key="PageBtnActive" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AppPurpleBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </Page.Resources>

  <Grid Margin="24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <controls:AppPageHeader Grid.Row="0"
                            Title="Product Catalog"
                            Subtitle="Manage sports gear, inventory, pricing, and status."
                            Margin="0,0,0,14"/>

    <!-- Top bar: search + actions -->
    <Grid Grid.Row="1" ColumnSpacing="14" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              MinHeight="48"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="20"
              Padding="12,8">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE721;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondary}" VerticalAlignment="Center"/>
          <TextBox x:Name="SearchBox"
                   Grid.Column="1"
                   PlaceholderText="Search sports gear or brand..."
                   Text="{Binding SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   KeyDown="OnSearchKeyDown"
                   BorderThickness="0" Background="Transparent" Padding="0,6" VerticalAlignment="Center"
                   FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
          <Button Grid.Column="2" Content="&#xE721;" FontFamily="Segoe MDL2 Assets" 
                  Command="{Binding SearchCommand}" Background="Transparent" BorderThickness="0" Padding="8"
                  Foreground="{StaticResource AppPurpleBrush}" Style="{StaticResource ColorPreservingButtonStyle}"/>
        </Grid>
      </Border>

      <Button x:Name="ImportButton"
              Grid.Column="1"
              Style="{StaticResource BulkImportButtonStyle}"
              Click="OnBulkImportClick">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE898;" FontSize="15"/>
          <TextBlock Text="Bulk Import" VerticalAlignment="Center" FontWeight="SemiBold" 
                     FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
        </StackPanel>
      </Button>

      <Button x:Name="AddButton"
              Grid.Column="2"
              Background="{StaticResource AppPurpleBrush}" Foreground="White" 
              CornerRadius="20" Padding="16,10" MinHeight="48" Style="{StaticResource ColorPreservingButtonStyle}"
              Click="OnAddItemClick">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE710;" FontSize="15" Foreground="White"/>
          <TextBlock Text="New Equipment" VerticalAlignment="Center" FontWeight="SemiBold" 
                     FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
        </StackPanel>
      </Button>
    </Grid>

    <Rectangle Grid.Row="2" Height="1" Margin="0,0,0,20" Fill="{ThemeResource ControlStrokeColorDefaultBrush}"/>

    <!-- Filters -->
    <Grid Grid.Row="3" ColumnSpacing="16" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource FilterPanelCardStyle}">
        <StackPanel Spacing="12">
          <TextBlock Text="Price Range" FontSize="15" FontWeight="SemiBold" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
          <controls:PriceRangeSlider Minimum="0" Maximum="500"
              LowerValue="{Binding PriceUsdMin, Mode=TwoWay}"
              UpperValue="{Binding PriceUsdMax, Mode=TwoWay}"/>
          <Border Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20" Padding="12,10">
            <TextBlock Text="{Binding PriceRangeSummary}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AppPurpleBrush}" 
                       FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
          </Border>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource FilterPanelCardStyle}">
        <StackPanel Spacing="16">
          <TextBlock Text="Sort By" FontSize="15" FontWeight="SemiBold" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
          <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SortField, Mode=TwoWay}" SelectionChanged="OnSortComboSelectionChanged" HorizontalAlignment="Stretch" CornerRadius="20">
            <ComboBoxItem Content="Name" Tag="name"/>
            <ComboBoxItem Content="Selling price" Tag="selling_price"/>
            <ComboBoxItem Content="Created" Tag="id"/>
          </ComboBox>
          <CheckBox Content="Ascending Order" IsChecked="{Binding IsSortAscending, Mode=TwoWay}" 
                    FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Table -->
    <Border Grid.Row="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Table Header -->
        <Border Grid.Row="0" Background="{ThemeResource ControlFillColorDefaultBrush}"
                CornerRadius="20" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1" Padding="16,14">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="200"/>
              <ColumnDefinition Width="130"/>
              <ColumnDefinition Width="96"/>
              <ColumnDefinition Width="168"/>
              <ColumnDefinition Width="118"/>
              <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="PRODUCT" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimary}" 
                       FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            <TextBlock Grid.Column="1" Text="CATEGORY" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimary}" 
                       FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            <TextBlock Grid.Column="2" Text="PRICE" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimary}" 
                       FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            <TextBlock Grid.Column="3" Text="STOCK LEVEL" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimary}" 
                       FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            <TextBlock Grid.Column="4" Text="STATUS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimary}" 
                       FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
          </Grid>
        </Border>

        <!-- Table Body -->
        <ListView Grid.Row="1" ItemsSource="{Binding Items}" IsItemClickEnabled="True" ItemClick="OnItemClick" SelectionMode="None" Padding="0,4"
                  Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="Padding" Value="16,0"/>
              <Setter Property="MinHeight" Value="64"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="m:SportItemListRow">
              <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="168"/>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="40"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="44" Height="44" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                      <Image Source="{x:Bind Item.ImageUrls, Converter={StaticResource FirstImageConverter}}" Width="44" Height="44" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{x:Bind Item.Name}" FontWeight="SemiBold" VerticalAlignment="Center" MaxLines="2" TextTrimming="CharacterEllipsis" 
                               FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                  </StackPanel>

                  <TextBlock Grid.Column="1" Text="{x:Bind CategoryName}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondary}" FontSize="13" 
                             FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>

                  <TextBlock Grid.Column="2" Text="{x:Bind Item.SellingPrice, Converter={StaticResource CurrencyFormatter}}" VerticalAlignment="Center" FontWeight="SemiBold" 
                             FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>

                  <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="4">
                    <ProgressBar Value="{x:Bind Item, Converter={StaticResource SportItemStockPercentConverter}}" 
                                 Foreground="{x:Bind Item, Converter={StaticResource SportItemStockBarForegroundConverter}}" Height="6"/>
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" 
                               FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans">
                      <Run Text="{x:Bind Item.EffectiveStockQuantity}" FontWeight="SemiBold"/><Run Text=" in stock"/>
                    </TextBlock>
                  </StackPanel>

                  <Border Grid.Column="4" CornerRadius="20" Padding="10,5" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Background="{x:Bind Item, Converter={StaticResource SportItemStatusBadgeBackgroundConverter}}">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind Item, Converter={StaticResource SportItemStatusBadgeForegroundConverter}}"
                               Text="{x:Bind Item, Converter={StaticResource SportItemStatusTextConverter}}" 
                               FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                  </Border>

                  <FontIcon Grid.Column="5" Glyph="&#xE10C;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondary}" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <!-- Loading overlay -->
        <StackPanel Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
          <ProgressBar IsIndeterminate="True" Width="120" Foreground="{StaticResource AppPurpleBrush}"/>
          <TextBlock Text="Loading products..." Foreground="{ThemeResource TextFillColorSecondary}" FontSize="13" 
                     FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
        </StackPanel>

        </Grid>
    </Border>

    <!-- Table Footer: Pagination (Outside Card) -->
    <Border Grid.Row="5" Padding="0,14">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Spacing="4">
          <TextBlock Text="Showing" Foreground="{ThemeResource TextFillColorSecondary}" FontSize="13" 
                     FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
          <TextBlock Text="{Binding DisplayFrom}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimary}" FontSize="13" 
                     FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
          <TextBlock Text="to" Foreground="{ThemeResource TextFillColorSecondary}" FontSize="13" 
                     FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
          <TextBlock Text="{Binding DisplayTo}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimary}" FontSize="13" 
                     FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
          <TextBlock Text="of" Foreground="{ThemeResource TextFillColorSecondary}" FontSize="13" 
                     FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
          <TextBlock Text="{Binding TotalItems}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimary}" FontSize="13" 
                     FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
          <TextBlock Text="products" Foreground="{ThemeResource TextFillColorSecondary}" FontSize="13" 
                     FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" x:Name="PaginationPanel"/>
      </Grid>
    </Border>

    <TextBlock Grid.Row="6" Margin="0,12,0,0" Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" 
               TextWrapping="Wrap" HorizontalAlignment="Center" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" 
               FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
  </Grid>
</Page>
