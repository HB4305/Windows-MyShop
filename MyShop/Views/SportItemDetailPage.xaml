<Page x:Class="MyShop.Views.SportItemDetailPage"
      x:Name="Root"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:MyShop.Models"
      xmlns:conv="using:MyShop.Converters"
      xmlns:behaviors="clr-namespace:MyShop.Behaviors;assembly=MyShop"
      xmlns:controls="using:MyShop.Controls"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <conv:InverseStringToVisibilityConverter x:Key="InverseStringToVisibilityConverter"/>
            <conv:StringToImageConverter x:Key="StringToImageConverter"/>

            <!-- Accent colors -->
            <SolidColorBrush x:Key="SportPurpleBrush" Color="#8B52FF"/>
            <SolidColorBrush x:Key="SportPurpleSoftBrush" Color="#8B52FF" Opacity="0.08"/>
            <SolidColorBrush x:Key="SportPurpleLightBrush" Color="#8B52FF" Opacity="0.12"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>

            <Style x:Key="DetailOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="20"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="MinHeight" Value="44"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <Style x:Key="DetailDeleteOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource DetailOutlineButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            </Style>

            <Style x:Key="DetailPurplePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{StaticResource SportPurpleBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="20"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="MinHeight" Value="44"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="DetailFieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <Style x:Key="DetailCardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="22"/>
            </Style>

            <Style x:Key="PremiumCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="20"/>
            </Style>

            <Style x:Key="UnifiedInputStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="24"/>
                <Setter Property="Padding" Value="12,12"/>
            </Style>

            <Style x:Key="LocalColorPreservingButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
            </Style>

            <LinearGradientBrush x:Key="AiGlassGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1A8B52FF" Offset="0"/>
                <GradientStop Color="#0D8B52FF" Offset="1"/>
            </LinearGradientBrush>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4"
                        VerticalAlignment="Center">
                <TextBlock Text="Edit product"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                <TextBlock Text="Create product"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVisibilityConverter}}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                <TextBlock Text="Enter details and images, then save to persist."
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <Button x:Name="DeleteButton"
                        Content="Delete"
                        Style="{StaticResource DetailDeleteOutlineButtonStyle}"
                        Command="{Binding DeleteCommand}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button Content="Discard"
                        Style="{StaticResource DetailOutlineButtonStyle}"
                        Click="OnDiscardClick"/>
                <Button x:Name="SaveButton"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource DetailPurplePrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <SymbolIcon Symbol="Save"
                                    Foreground="White"
                                    VerticalAlignment="Center"/>
                        <TextBlock Text="Save changes"
                                   VerticalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="MainFormGrid" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                <!-- Left: gallery + AI card -->
                <StackPanel Grid.Column="0"
                            Spacing="18">
                    <Border Style="{StaticResource DetailCardBorderStyle}"
                            Padding="16">
                        <StackPanel Spacing="12">
                            <Grid Height="280"
                                  CornerRadius="24">
                                <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="24"
                                        Visibility="{Binding PreviewImageUrl, Converter={StaticResource InverseStringToVisibilityConverter}}">
                                    <TextBlock Text="No image"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                                </Border>
                                <Image Source="{Binding PreviewImageUrl, Converter={StaticResource StringToImageConverter}}"
                                       Stretch="UniformToFill"
                                       Tapped="OnImageTapped"
                                       IsHitTestVisible="True"
                                       Visibility="{Binding PreviewImageUrl, Converter={StaticResource StringToVisibilityConverter}}"/>

                                <!-- Image Navigation Overlays -->
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="8">
                                    <Button Command="{Binding SelectPreviousImageCommand}"
                                            Style="{StaticResource LocalColorPreservingButtonStyle}"
                                            Background="#40000000"
                                            Foreground="White"
                                            Width="32" Height="32" CornerRadius="16"
                                            HorizontalAlignment="Left">
                                        <FontIcon Glyph="&#xE76B;" FontSize="12"/>
                                    </Button>
                                    <Button Command="{Binding SelectNextImageCommand}"
                                            Style="{StaticResource LocalColorPreservingButtonStyle}"
                                            Background="#40000000"
                                            Foreground="White"
                                            Width="32" Height="32" CornerRadius="16"
                                            HorizontalAlignment="Right">
                                        <FontIcon Glyph="&#xE76C;" FontSize="12"/>
                                    </Button>
                                </Grid>

                                <Button HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="8"
                                        Width="36"
                                        Height="36"
                                        Padding="0"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="24"
                                        Opacity="0.95"
                                        Command="{Binding ViewImageDetailCommand}"
                                        CommandParameter="{Binding PreviewImageUrl}"
                                        Style="{StaticResource LocalColorPreservingButtonStyle}">
                                    <SymbolIcon Symbol="Zoom"/>
                                </Button>
                            </Grid>

                            <ScrollViewer HorizontalScrollMode="Enabled"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollMode="Disabled"
                                          VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="10">
                                    <ListView x:Name="ImageThumbnailsListView"
                                              ItemsSource="{Binding ImageUrls, Mode=TwoWay}"
                                              SelectedIndex="{Binding SelectedImageIndex, Mode=TwoWay}"
                                              SelectionMode="Single"
                                              Padding="0"
                                              Width="Auto"
                                              CanReorderItems="True"
                                              CanDragItems="True"
                                              AllowDrop="True">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding"
                                                        Value="0"/>
                                                <Setter Property="MinWidth"
                                                        Value="0"/>
                                                <Setter Property="Margin"
                                                        Value="0,0,0,0"/>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Width="72"
                                                      Height="72"
                                                      CornerRadius="24">
                                                    <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="24">
                                                        <Image Source="{Binding Converter={StaticResource StringToImageConverter}}"
                                                               Stretch="UniformToFill"/>
                                                    </Border>
                                                    <Button Click="OnDeleteImageClick"
                                                            Tag="{Binding}"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="2"
                                                            Width="22"
                                                            Height="22"
                                                            Padding="0"
                                                            Background="{StaticResource DangerBrush}"
                                                            CornerRadius="24"
                  Style="{StaticResource LocalColorPreservingButtonStyle}">
                                                        <SymbolIcon Symbol="Cancel"
                                                                    Foreground="White"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <StackPanel Orientation="Vertical"
                                                Spacing="6"
                                                VerticalAlignment="Center">
                                        <Button Command="{Binding MoveSelectedImageEarlierCommand}"
                                                Style="{StaticResource DetailOutlineButtonStyle}"
                                                MinWidth="44"
                                                MinHeight="36"
                                                Padding="8,4"
                                                ToolTipService.ToolTip="Move left">
                                            <FontIcon Glyph="&#xE76B;"
                                                      FontSize="12"/>
                                        </Button>
                                        <Button Command="{Binding MoveSelectedImageLaterCommand}"
                                                Style="{StaticResource DetailOutlineButtonStyle}"
                                                MinWidth="44"
                                                MinHeight="36"
                                                Padding="8,4"
                                                ToolTipService.ToolTip="Move right">
                                            <FontIcon Glyph="&#xE76C;"
                                                      FontSize="12"/>
                                        </Button>
                                    </StackPanel>

                                    <Button Command="{Binding PickImageCommand}"
                                            Width="72"
                                            Height="72"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="2"
                                            CornerRadius="24"
                  Style="{StaticResource LocalColorPreservingButtonStyle}">
                                        <StackPanel Spacing="2"
                                                    VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE710;"
                                                      FontSize="18"
                                                      Foreground="{StaticResource SportPurpleBrush}"/>
                                            <TextBlock Text="Add"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource AiGlassGradient}"
                            BorderBrush="{StaticResource SportPurpleLightBrush}"
                            BorderThickness="1"
                            CornerRadius="24"
                            Padding="20">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10">
                                <Border Background="{StaticResource SportPurpleBrush}" 
                                        CornerRadius="8" 
                                        Padding="6">
                                    <FontIcon Glyph="&#xEF58;" 
                                              FontSize="14"
                                              Foreground="White"/>
                                </Border>
                                <TextBlock Text="AI Content Assistant"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           FontSize="15"
                                           Foreground="{StaticResource SportPurpleBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                            </StackPanel>
                            <TextBlock Text="Effortlessly generate product details, pricing, and variants directly from your images."
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Opacity="0.8" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                            <Button HorizontalAlignment="Stretch"
                                    Background="{StaticResource SportPurpleBrush}"
                                    Foreground="White"
                                    Height="40"
                                    CornerRadius="10"
                                    Command="{Binding AutoFillDetailsCommand}"
                                    Style="{StaticResource DefaultButtonStyle}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="10"
                                                HorizontalAlignment="Center"
                                                Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <FontIcon Glyph="&#xEF58;" FontSize="16"/>
                                        <TextBlock Text="AI Auto-fill Details" FontWeight="SemiBold" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                                    </StackPanel>
                                    <ProgressRing IsActive="True"
                                                  Width="20"
                                                  Height="20"
                                                  Foreground="{StaticResource SportPurpleBrush}"
                                                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </Button>
                            <TextBlock Text="Tip: Upload an image first for better results!"
                                       FontSize="11"
                                       FontStyle="Italic"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>


                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: form -->
                <Border Grid.Column="1"
                        Style="{StaticResource DetailCardBorderStyle}">
                    <StackPanel Spacing="20"
                                MaxWidth="840"
                                HorizontalAlignment="Stretch">
                        <StackPanel Spacing="6">
                            <TextBlock Text="PRODUCT NAME"
                                       Style="{StaticResource DetailFieldLabelStyle}"/>
                            <TextBox Style="{StaticResource UnifiedInputStyle}"
                                     Text="{Binding Item.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="e.g. Apex Carbon Pro Tennis Racket"/>
                        </StackPanel>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Spacing="6">
                                <TextBlock Text="PRICE (USD)"
                                           Style="{StaticResource DetailFieldLabelStyle}"/>
                                <Grid>
                                    <controls:DecimalTextBox Style="{StaticResource UnifiedInputStyle}"
                                                             Text="{Binding SellingPriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             PlaceholderText="0.00"
                                                             Padding="34,10,12,10"/>
                                    <TextBlock Text="$"
                                               VerticalAlignment="Center"
                                               Margin="14,0,0,0"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Spacing="6">
                                <TextBlock Text="CATEGORY"
                                           Style="{StaticResource DetailFieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Categories, Mode=OneWay}"
                                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          HorizontalAlignment="Stretch"
                                          CornerRadius="24"
                                          Padding="12,12"
                                          BorderThickness="1"
                                          BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                          Background="{ThemeResource ControlFillColorDefaultBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Fixed-attribute variant matrix (multi-row) -->
                        <StackPanel Spacing="12">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE71D;" Foreground="{StaticResource SportPurpleBrush}" FontSize="16"/>
                                    <TextBlock Text="Variants Matrix"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right"
                                        Content="+ Add Variant"
                                        Style="{StaticResource DefaultButtonStyle}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{StaticResource SportPurpleBrush}"
                                        FontWeight="SemiBold"
                                        Command="{Binding AddVariantCommand}"/>
                            </Grid>
                            <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <StackPanel Padding="16"
                                            Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="SIZE"
                                                   Style="{StaticResource DetailFieldLabelStyle}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="COLOR"
                                                   Style="{StaticResource DetailFieldLabelStyle}"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="STOCK"
                                                   Style="{StaticResource DetailFieldLabelStyle}"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="SKU"
                                                   Style="{StaticResource DetailFieldLabelStyle}"/>
                                        <Border Grid.Column="4" Width="86"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{x:Bind ViewModel.Variants, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:SportItemVariant">
                                                <Grid ColumnSpacing="12"
                                                      Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBox Grid.Column="0"
                                                             Style="{StaticResource UnifiedInputStyle}"
                                                             Text="{x:Bind SizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             PlaceholderText="Size (e.g. 9, XL)"/>
                                                    <TextBox Grid.Column="1"
                                                             Style="{StaticResource UnifiedInputStyle}"
                                                             Text="{x:Bind Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             PlaceholderText="Color"/>
                                                    <controls:NumericTextBox Grid.Column="2"
                                                                             Style="{StaticResource UnifiedInputStyle}"
                                                                             Text="{x:Bind StockQuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             PlaceholderText="Stock"/>
                                                    <TextBox Grid.Column="3"
                                                             Style="{StaticResource UnifiedInputStyle}"
                                                             Text="{x:Bind Sku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             PlaceholderText="SKU"/>
                                                    <Button Grid.Column="4"
                                                            Content="Remove"
                                                            Style="{StaticResource DetailDeleteOutlineButtonStyle}"
                                                            Command="{Binding ElementName=Root, Path=DataContext.RemoveVariantCommand}"
                                                            CommandParameter="{Binding}"
                                                            MinWidth="86"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Spacing="6">
                                <TextBlock Text="LOW STOCK THRESHOLD"
                                           Style="{StaticResource DetailFieldLabelStyle}"/>
                                <controls:NumericTextBox Style="{StaticResource UnifiedInputStyle}"
                                                         Text="{Binding LowStockThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         PlaceholderText="0"
                                             Padding="12,12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Spacing="6"
                                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="COST PRICE (USD)"
                                           Style="{StaticResource DetailFieldLabelStyle}"/>
                                <controls:DecimalTextBox Style="{StaticResource UnifiedInputStyle}"
                                                         Text="{Binding CostPriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         PlaceholderText="0.00"
                                             Padding="12,12"
                                                         IsEnabled="False"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock Text="PRODUCT DESCRIPTION" Style="{StaticResource DetailFieldLabelStyle}"/>
                                <Button HorizontalAlignment="Right"
                                        Command="{Binding GenerateAiDescriptionCommand}"
                                        Padding="8,4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ToolTipService.ToolTip="Regenerate with AI"
                  Style="{StaticResource LocalColorPreservingButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xEF58;" FontSize="14" Foreground="{StaticResource SportPurpleBrush}"/>
                                        <TextBlock Text="AI Magic" FontSize="11" Foreground="{StaticResource SportPurpleBrush}" FontWeight="SemiBold" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBox Style="{StaticResource UnifiedInputStyle}"
                                     Text="{Binding ProductDescriptionUi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="160"
                                     Padding="12,12"
                                     PlaceholderText="Describe your product or use AI to generate it..."/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Spacing="8"
                    Margin="0,16,0,0">
            <ProgressBar IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
        </StackPanel>
    </Grid>
</Page>

