<Page x:Class="MyShop.Views.ShiftReportLogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:MyShop.Controls"
      xmlns:conv="using:MyShop.Converters"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Page.Resources>
    <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    <conv:CurrencyFormatter x:Key="CurrencyFormatter"/>
    <conv:DateTimeOffsetConverter x:Key="DateTimeOffsetConverter"/>

    <SolidColorBrush x:Key="AppPurpleBrush" Color="#8B52FF"/>
    <SolidColorBrush x:Key="PurpleLightBrush" Color="#8B52FF" Opacity="0.12"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>

    <Style x:Key="StatsCardStyle" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
      <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Padding" Value="18"/>
    </Style>

    <!-- Pagination Button Styles -->
    <Style x:Key="PageBtn" TargetType="Button">
      <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
    </Style>

    <Style x:Key="PageBtnActive" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AppPurpleBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </Page.Resources>

  <Grid Padding="24,20" RowSpacing="20">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="NarrowState">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0"/>
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="StatsGrid.ColumnDefinitions[1].Width" Value="0"/>
            <Setter Target="StatsGrid.ColumnDefinitions[2].Width" Value="0"/>
            <Setter Target="Card2.(Grid.Row)" Value="1"/>
            <Setter Target="Card2.(Grid.Column)" Value="0"/>
            <Setter Target="Card2.Margin" Value="0,12,0,0"/>
            <Setter Target="Card3.(Grid.Row)" Value="2"/>
            <Setter Target="Card3.(Grid.Column)" Value="0"/>
            <Setter Target="Card3.Margin" Value="0,12,0,0"/>

            <Setter Target="ToolbarGridBorder.Margin" Value="0,12,0,0"/>
            <Setter Target="ToolbarGridBorder.HorizontalAlignment" Value="Stretch"/>
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="WideState">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1000"/>
          </VisualState.StateTriggers>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid x:Name="HeaderPanel" Grid.Row="0">
      <controls:AppPageHeader Title="Shift Logs"
                              Subtitle="Review submitted shift reports, discrepancies, and cashier notes."/>
    </Grid>

    <!-- Stats Summary -->
    <Grid x:Name="StatsGrid" Grid.Row="1" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border x:Name="Card1" Grid.Row="0" Grid.Column="0" Style="{StaticResource StatsCardStyle}">
        <StackPanel Spacing="8">
          <TextBlock Text="Total Reports" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
          <TextBlock Text="{Binding TotalReports}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        </StackPanel>
      </Border>

      <Border x:Name="Card2" Grid.Column="1" Style="{StaticResource StatsCardStyle}">
        <StackPanel Spacing="8">
          <TextBlock Text="Issues/Losses" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
          <TextBlock Text="{Binding NegativeDiscrepancyReports}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
        </StackPanel>
      </Border>

      <Border x:Name="Card3" Grid.Column="2" Style="{StaticResource StatsCardStyle}">
        <StackPanel Spacing="8">
          <TextBlock Text="Total Revenue" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
          <TextBlock Text="{Binding TotalRevenue, Converter={StaticResource CurrencyFormatter}}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Standardized Premium Search Bar (Matching Report Design) -->
    <Grid x:Name="ToolbarGridBorder" Grid.Row="2" VerticalAlignment="Center">
        <AutoSuggestBox x:Name="SearchBox"
                        PlaceholderText="Search logs..."
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        QuerySubmitted="OnSearchQuerySubmitted"
                        QueryIcon="Find"
                        CornerRadius="24"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        Padding="16,12,12,12"
                        Height="48"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans">
            <AutoSuggestBox.Resources>
                <!-- Style the internal search button -->
                <Style TargetType="Button" x:Key="AutoSuggestBoxQueryButtonStyle">
                    <Setter Property="Foreground" Value="{StaticResource AppPurpleBrush}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
                <!-- Targeted style to hide the clear button -->
                <Style TargetType="Button" x:Key="AutoSuggestBoxDeleteButtonStyle">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Setter Property="Width" Value="0"/>
                </Style>
            </AutoSuggestBox.Resources>
        </AutoSuggestBox>
    </Grid>

    <!-- Main List Card -->
    <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20">
      <ScrollViewer HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Auto">
      <Grid MinWidth="1160">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- Table Header (Synced with Staff) -->
        <Border Grid.Row="0" Background="{ThemeResource ControlFillColorDefaultBrush}"
                CornerRadius="20" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1" Padding="16,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="80"/>
              <ColumnDefinition Width="200"/>
              <ColumnDefinition Width="150"/>
              <ColumnDefinition Width="150"/>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="100"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="ID" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="STAFF" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="START" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="3" Text="SUBMITTED" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="4" Text="REVENUE" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="5" Text="EXPECTED" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="6" Text="ACTUAL" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="7" Text="DIFF" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="8" Text="NOTES" FontSize="11" FontWeight="SemiBold" Margin="20,0,0,0"/>
          </Grid>
        </Border>

        <!-- Table Body -->
        <ListView Grid.Row="1" ItemsSource="{Binding PagedReportLogs}" SelectionMode="None" Padding="0,4"
                  Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="Padding" Value="16,0"/>
              <Setter Property="MinHeight" Value="56"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding ShiftId}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="1" Text="{Binding StaffEmail}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="2" Text="{Binding StartTime, Converter={StaticResource DateTimeOffsetConverter}}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  <TextBlock Grid.Column="3" Text="{Binding EndTime, Converter={StaticResource DateTimeOffsetConverter}}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  <TextBlock Grid.Column="4" Text="{Binding TotalRevenue, Converter={StaticResource CurrencyFormatter}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="5" Text="{Binding ExpectedCash, Converter={StaticResource CurrencyFormatter}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="6" Text="{Binding ActualCashTotal, Converter={StaticResource CurrencyFormatter}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="7" Text="{Binding Discrepancy, Converter={StaticResource CurrencyFormatter}}" HorizontalAlignment="Right" VerticalAlignment="Center" 
                             Foreground="{Binding Discrepancy, Converter={StaticResource CurrencyFormatter}, ConverterParameter='color'}"/>
                  <TextBlock Grid.Column="8" Text="{Binding Notes}" VerticalAlignment="Center" Margin="20,0,0,0" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <!-- Loading State -->
        <StackPanel Grid.Row="1" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <controls:ShiftLogSkeletonRow/>
            <controls:ShiftLogSkeletonRow/>
            <controls:ShiftLogSkeletonRow/>
            <controls:ShiftLogSkeletonRow/>
            <controls:ShiftLogSkeletonRow/>
            <controls:ShiftLogSkeletonRow/>
            <controls:ShiftLogSkeletonRow/>
            <controls:ShiftLogSkeletonRow/>
        </StackPanel>
      </Grid>
      </ScrollViewer>
    </Border>

    <!-- Table Footer: Pagination (Docked to bottom) -->
    <Border Grid.Row="4" 
            BorderThickness="0"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            Margin="-24,0,-24,-20" Padding="24,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Spacing="4">
          <TextBlock Text="Showing" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" 
                     FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
          <TextBlock Text="{Binding DisplayFrom}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" 
                     FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
          <TextBlock Text="to" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" 
                     FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
          <TextBlock Text="{Binding DisplayTo}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" 
                     FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
          <TextBlock Text="of" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" 
                     FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
          <TextBlock Text="{Binding TotalFilteredItems}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" 
                     FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
          <TextBlock Text="logs" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" 
                     FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" x:Name="ShiftLogsPaginationPanel"/>
      </Grid>
    </Border>
  </Grid>
</Page>
