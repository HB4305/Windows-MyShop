<Page x:Class="MyShop.Views.ShiftReportLogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:MyShop.Converters"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Page.Resources>
    <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
    <conv:CurrencyFormatter x:Key="CurrencyFormatter"/>
    <conv:DateTimeOffsetConverter x:Key="DateTimeOffsetConverter"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#8B52FF"/>
    <SolidColorBrush x:Key="PurpleLightBrush" Color="#8B52FF" Opacity="0.12"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>

    <Style x:Key="PanelBorder" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
      <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
    </Style>
  </Page.Resources>

  <Grid Padding="24,20" RowSpacing="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Spacing="2">
        <TextBlock Text="Shift Log"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="{ThemeResource TextFillColorPrimary}"/>
        <TextBlock Text="Review submitted shift reports, discrepancies, and cashier notes from staff."
                   FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondary}"/>
      </StackPanel>

      <Button Grid.Column="1"
              Click="BackToShiftManagement_Click"
              Background="{ThemeResource ControlFillColorDefaultBrush}"
              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
              BorderThickness="1"
              Padding="14,10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE72B;" FontSize="14"/>
          <TextBlock Text="Back"/>
        </StackPanel>
      </Button>
    </Grid>

    <Border Grid.Row="1"
            Style="{StaticResource PanelBorder}"
            Padding="16"
            Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
      <TextBlock Text="{Binding StatusMessage}"
                 TextWrapping="Wrap"
                 Foreground="{ThemeResource TextFillColorPrimary}"/>
    </Border>

    <Grid Grid.Row="2" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource PanelBorder}" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="Closed Reports" Foreground="{ThemeResource TextFillColorSecondary}"/>
          <TextBlock Text="{Binding TotalReports}" FontSize="24" FontWeight="Bold"/>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="Negative Discrepancies" Foreground="{ThemeResource TextFillColorSecondary}"/>
          <TextBlock Text="{Binding NegativeDiscrepancyReports}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="Total Revenue" Foreground="{ThemeResource TextFillColorSecondary}"/>
          <TextBlock Text="{Binding TotalRevenue, Converter={StaticResource CurrencyFormatter}}" FontSize="24" FontWeight="Bold"/>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="18">
      <Grid RowSpacing="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="Search by shift id, staff email, or note..."
                   MinHeight="42"/>

          <ProgressRing Grid.Column="1"
                        Width="28"
                        Height="28"
                        IsActive="{Binding IsLoading}"
                        VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1">
          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
            <Grid MinWidth="1540">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <Border Grid.Row="0"
                      BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
                      BorderThickness="0,0,0,1"
                      Padding="12,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Shift" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="Staff" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="Started At" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Column="3" Text="Submitted At" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Column="4" Text="Revenue" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Column="5" Text="Expected" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Column="6" Text="Actual" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Column="7" Text="Discrepancy" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Column="8" Text="Customers" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Column="9" Text="Reason Note" HorizontalAlignment="Center"/>
                </Grid>
              </Border>

              <ListView Grid.Row="1"
                        ItemsSource="{Binding FilteredReportLogs}"
                        SelectionMode="None"
                        BorderThickness="0"
                        Background="Transparent"
                        Padding="0,4"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Grid Padding="12,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding ShiftId}" HorizontalAlignment="Center" TextAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding StaffEmail}" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="2" Text="{Binding StartTime, Converter={StaticResource DateTimeOffsetConverter}}" HorizontalAlignment="Center" TextAlignment="Center"/>
                      <TextBlock Grid.Column="3" Text="{Binding EndTime, Converter={StaticResource DateTimeOffsetConverter}}" HorizontalAlignment="Center" TextAlignment="Center"/>
                      <TextBlock Grid.Column="4" Text="{Binding TotalRevenue, Converter={StaticResource CurrencyFormatter}}" HorizontalAlignment="Center" TextAlignment="Center"/>
                      <TextBlock Grid.Column="5" Text="{Binding ExpectedCash, Converter={StaticResource CurrencyFormatter}}" HorizontalAlignment="Center" TextAlignment="Center"/>
                      <TextBlock Grid.Column="6" Text="{Binding ActualCashTotal, Converter={StaticResource CurrencyFormatter}}" HorizontalAlignment="Center" TextAlignment="Center"/>
                      <TextBlock Grid.Column="7" Text="{Binding Discrepancy, Converter={StaticResource CurrencyFormatter}}" HorizontalAlignment="Center" TextAlignment="Center"/>
                      <TextBlock Grid.Column="8" Text="{Binding CustomerCount}" HorizontalAlignment="Center" TextAlignment="Center"/>
                      <TextBlock Grid.Column="9" Text="{Binding Notes}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </ScrollViewer>

          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="10"
                      Visibility="{Binding FilteredReportLogs.Count, Converter={StaticResource CountToVisibilityConverter}}">
            <Border Width="60" Height="60" CornerRadius="30" Background="{StaticResource PurpleLightBrush}">
              <FontIcon Glyph="&#xE9D2;" FontSize="28" Foreground="{StaticResource PurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="No shift reports found" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondary}"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Page>
