<Page x:Class="MyShop.Views.ShiftManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:MyShop.Converters"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Page.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#8B52FF"/>
    <SolidColorBrush x:Key="PurpleLightBrush" Color="#8B52FF" Opacity="0.12"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>

    <Style x:Key="PanelBorder" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
      <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
    </Style>
  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Padding="24,20" RowSpacing="18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="2">
          <TextBlock Text="Shift Management"
                     FontSize="28"
                     FontWeight="Bold"
                     Foreground="{ThemeResource TextFillColorPrimary}"/>
          <TextBlock Text="Track cashier sessions, expected cash, and drawer reconciliation."
                     FontSize="13"
                     Foreground="{ThemeResource TextFillColorSecondary}"/>
        </StackPanel>
        <Button Grid.Column="1"
                Click="ViewReportLogs_Click"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="14,10"
                ToolTipService.ToolTip="View submitted shift reports">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE9D2;" FontSize="14"/>
            <TextBlock Text="Report Logs"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="2"
                Command="{Binding LoadActiveShiftCommand}"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="14,10"
                ToolTipService.ToolTip="Refresh shift data">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
            <TextBlock Text="Refresh"/>
          </StackPanel>
        </Button>
      </Grid>

      <Border Grid.Row="1"
              Style="{StaticResource PanelBorder}"
              Padding="18"
              Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <FontIcon Glyph="&#xE946;" Foreground="{StaticResource PurpleBrush}" FontSize="16"/>
          <TextBlock Text="{Binding StatusMessage}"
                     Foreground="{ThemeResource TextFillColorPrimary}"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Grid Grid.Row="2" ColumnSpacing="12" RowSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource PanelBorder}" Padding="16">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xEAFD;" Foreground="{StaticResource PurpleBrush}" FontSize="16"/>
              <TextBlock Text="Shift Revenue" Foreground="{ThemeResource TextFillColorSecondary}"/>
            </StackPanel>
            <TextBlock Text="{Binding ShiftRevenue, Converter={StaticResource CurrencyFormatter}}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{ThemeResource TextFillColorPrimary}"/>
            <TextBlock Text="Paid sales recorded in the active shift."
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondary}"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Padding="16">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE716;" Foreground="{StaticResource SuccessBrush}" FontSize="16"/>
              <TextBlock Text="Customers Served" Foreground="{ThemeResource TextFillColorSecondary}"/>
            </StackPanel>
            <TextBlock Text="{Binding ShiftCustomerCount}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{ThemeResource TextFillColorPrimary}"/>
            <TextBlock Text="Each completed order counts as one customer served."
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondary}"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="16">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE9D9;" Foreground="{StaticResource WarningBrush}" FontSize="16"/>
              <TextBlock Text="Average Spend" Foreground="{ThemeResource TextFillColorSecondary}"/>
            </StackPanel>
            <TextBlock Text="{Binding AverageSpendPerCustomer, Converter={StaticResource CurrencyFormatter}}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{ThemeResource TextFillColorPrimary}"/>
            <TextBlock Text="Average revenue per served customer in this shift."
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondary}"/>
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="3" ColumnSpacing="18" RowSpacing="18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="360"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource PanelBorder}"
                Padding="18">
          <StackPanel Spacing="16">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE8C7;" Foreground="{StaticResource PurpleBrush}" FontSize="18"/>
                <TextBlock Text="Current Shift"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimary}"/>
              </StackPanel>
              <TextBlock Text="Open a shift before using POS checkout."
                         FontSize="12"
                         Foreground="{ThemeResource TextFillColorSecondary}"/>
            </StackPanel>

            <Border Background="{StaticResource PurpleLightBrush}"
                    CornerRadius="8"
                    Padding="14"
                    Visibility="{Binding HasActiveShift, Converter={StaticResource BoolToVisibilityConverter}}">
              <StackPanel Spacing="8">
                <Grid>
                  <TextBlock Text="Status"
                             Foreground="{ThemeResource TextFillColorSecondary}"/>
                  <Border HorizontalAlignment="Right"
                          Background="{StaticResource SuccessBrush}"
                          CornerRadius="12"
                          Padding="10,3">
                    <TextBlock Text="OPEN"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                  </Border>
                </Grid>
                <Grid>
                  <TextBlock Text="Shift ID" Foreground="{ThemeResource TextFillColorSecondary}"/>
                  <TextBlock Text="{Binding ActiveShift.Id}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>
                <Grid>
                  <TextBlock Text="Starting Cash" Foreground="{ThemeResource TextFillColorSecondary}"/>
                  <TextBlock Text="{Binding ActiveShift.StartingCash, Converter={StaticResource CurrencyFormatter}}"
                             HorizontalAlignment="Right"
                             FontWeight="SemiBold"/>
                </Grid>
                <Grid>
                  <TextBlock Text="Started At" Foreground="{ThemeResource TextFillColorSecondary}"/>
                  <TextBlock Text="{Binding ActiveShift.StartTime}"
                             HorizontalAlignment="Right"
                             FontWeight="SemiBold"/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Visibility="{Binding HasActiveShift, Converter={StaticResource InverseBoolToVisibilityConverter}}">
              <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="Starting Cash"
                             FontWeight="SemiBold"
                             Foreground="{ThemeResource TextFillColorPrimary}"/>
                  <TextBox Text="{Binding StartingCashText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           PlaceholderText="0.00"
                           MinHeight="42"/>
                </StackPanel>
                <Button Command="{Binding OpenShiftCommand}"
                        Background="{StaticResource PurpleBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="16,12"
                        HorizontalAlignment="Stretch">
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE710;" Foreground="White" FontSize="14"/>
                    <TextBlock Text="Open Shift" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Style="{StaticResource PanelBorder}"
                Padding="18">
          <StackPanel Spacing="18">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE9D2;" Foreground="{StaticResource PurpleBrush}" FontSize="18"/>
                <TextBlock Text="Cash Reconciliation"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimary}"/>
              </StackPanel>
              <TextBlock Text="Expected cash is calculated from cash POS orders in the active shift."
                         FontSize="12"
                         Foreground="{ThemeResource TextFillColorSecondary}"/>
            </StackPanel>

            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource PanelBorder}" Padding="14">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8C7;" Foreground="{StaticResource PurpleBrush}" FontSize="16"/>
                    <TextBlock Text="Expected Cash" Foreground="{ThemeResource TextFillColorSecondary}"/>
                  </StackPanel>
                  <TextBlock Text="{Binding ExpectedCash, Converter={StaticResource CurrencyFormatter}}"
                             FontSize="26"
                             FontWeight="Bold"
                             Foreground="{ThemeResource TextFillColorPrimary}"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Padding="14">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8D2;" Foreground="{StaticResource SuccessBrush}" FontSize="16"/>
                    <TextBlock Text="Actual Cash" Foreground="{ThemeResource TextFillColorSecondary}"/>
                  </StackPanel>
                  <TextBox Text="{Binding ActualCashTotalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           PlaceholderText="0.00"
                           MinHeight="42"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="14">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7BA;" Foreground="{StaticResource WarningBrush}" FontSize="16"/>
                    <TextBlock Text="Discrepancy" Foreground="{ThemeResource TextFillColorSecondary}"/>
                  </StackPanel>
                  <TextBlock Text="{Binding Discrepancy, Converter={StaticResource CurrencyFormatter}}"
                             FontSize="26"
                             FontWeight="Bold"
                             Foreground="{StaticResource WarningBrush}"/>
                </StackPanel>
              </Border>
            </Grid>

            <StackPanel Spacing="6">
              <TextBlock Text="Notes"
                         FontWeight="SemiBold"
                         Foreground="{ThemeResource TextFillColorPrimary}"/>
              <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText="Add cash differences or shift notes..."
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="120"/>
            </StackPanel>

            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ProgressRing IsActive="{Binding IsBusy}"
                            Width="28"
                            Height="28"
                            VerticalAlignment="Center"/>
              <Button Grid.Column="1"
                      Command="{Binding CloseShiftCommand}"
                      IsEnabled="{Binding HasActiveShift}"
                      Background="{StaticResource SuccessBrush}"
                      Foreground="White"
                      BorderThickness="0"
                      Padding="18,12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE73E;" Foreground="White" FontSize="14"/>
                  <TextBlock Text="Submit Shift Report" FontWeight="SemiBold"/>
                </StackPanel>
              </Button>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</Page>
