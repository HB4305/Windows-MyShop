<Application x:Class="MyShop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MyShop"
             xmlns:conv="using:MyShop.Converters">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- ── Value Converters ── -->
      <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
      <conv:NullToBoolConverter x:Key="NullToBoolConverter"/>
      <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
      <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
      <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
      <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
      <conv:InverseStringToVisibilityConverter x:Key="InverseStringToVisibilityConverter"/>
      <conv:BoolToForegroundConverter x:Key="BoolToForegroundConverter"/>
      <conv:HexToBrushConverter x:Key="HexToBrushConverter"/>
      <conv:StringToBoolConverter x:Key="StringToBoolConverter"/>
      <conv:CurrencyFormatter x:Key="CurrencyFormatter"/>
      <conv:PercentageFormatter x:Key="PercentageFormatter"/>
      <conv:DateFormatter x:Key="DateFormatter"/>
      <conv:OrderStatusToBrushConverter x:Key="OrderStatusToBrushConverter"/>
      <conv:OrderStatusToForegroundConverter x:Key="OrderStatusToForegroundConverter"/>
      <conv:PaymentStatusToBrushConverter x:Key="PaymentStatusToBrushConverter"/>
      <conv:CurrencyConverter x:Key="CurrencyConverter"/>
      <conv:DateTimeOffsetConverter x:Key="DateTimeOffsetConverter"/>
      <conv:LineTotalConverter x:Key="LineTotalConverter"/>
      <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
      <conv:CountToVisibilityInverseConverter x:Key="CountToVisibilityInverseConverter"/>
      <conv:OrderIdConverter x:Key="OrderIdConverter"/>

      <!-- ── Branding Colors ── -->
      <Color x:Key="AppAccentColor">#8B52FF</Color>
      <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
      <SolidColorBrush x:Key="AppAccentBrushLow" Color="{StaticResource AppAccentColor}" Opacity="0.12" />
      
      <!-- Standardized Brushes for pages -->
      <SolidColorBrush x:Key="AppPurpleBrush" Color="#8B52FF"/>
      <SolidColorBrush x:Key="PurpleBrush" Color="#8B52FF"/>
      <SolidColorBrush x:Key="PurpleLightBrush" Color="#8B52FF" Opacity="0.12"/>
      <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
      <SolidColorBrush x:Key="TextBoxBorderBrush" Color="#D1D5DB"/>

      <!-- Skeleton brushes are defined per-theme below (ThemeDictionaries)
           to support live theme switching and avoid GradientStop binding bug -->

      <!-- ── Pagination Button Styles ── -->

      
      <Style x:Key="PagerIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4"/>
      </Style>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <Color x:Key="SystemAccentColor">#8B52FF</Color>
          <Color x:Key="SystemAccentColorDark1">#7A44E8</Color>
          <Color x:Key="SystemAccentColorDark2">#6738CC</Color>
          <Color x:Key="SystemAccentColorDark3">#552EAD</Color>
          <Color x:Key="SystemAccentColorLight1">#9B69FF</Color>
          <Color x:Key="SystemAccentColorLight2">#AD83FF</Color>
          <Color x:Key="SystemAccentColorLight3">#C09DFF</Color>
          <CornerRadius x:Key="ControlCornerRadius">20</CornerRadius>
          <FontFamily x:Key="AppDefaultFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
          <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
          <FontFamily x:Key="ControlContentThemeFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
          <FontFamily x:Key="TextControlThemeFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
          <Color x:Key="SkeletonBaseColor">#252525</Color>
          <!-- SkeletonBaseBrush: solid dark surface for skeleton blocks -->
          <SolidColorBrush x:Key="SkeletonBaseBrush" Color="#252525"/>
          <!-- SkeletonShimmerBrush: sweep gradient; same-hue transparent stops prevent black fringing -->
          <LinearGradientBrush x:Key="SkeletonShimmerBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#00252525" Offset="0"/>
            <GradientStop Color="#3D3D3D"   Offset="0.5"/>
            <GradientStop Color="#00252525" Offset="1"/>
          </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="SystemAccentColor">#8B52FF</Color>
          <Color x:Key="SystemAccentColorDark1">#7A44E8</Color>
          <Color x:Key="SystemAccentColorDark2">#6738CC</Color>
          <Color x:Key="SystemAccentColorDark3">#552EAD</Color>
          <Color x:Key="SystemAccentColorLight1">#9B69FF</Color>
          <Color x:Key="SystemAccentColorLight2">#AD83FF</Color>
          <Color x:Key="SystemAccentColorLight3">#C09DFF</Color>
          <CornerRadius x:Key="ControlCornerRadius">20</CornerRadius>
          <FontFamily x:Key="AppDefaultFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
          <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
          <FontFamily x:Key="ControlContentThemeFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
          <FontFamily x:Key="TextControlThemeFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
          <Color x:Key="SkeletonBaseColor">#DEDEDE</Color>
          <!-- SkeletonBaseBrush: mid-gray surface visible on white backgrounds -->
          <SolidColorBrush x:Key="SkeletonBaseBrush" Color="#DEDEDE"/>
          <!-- SkeletonShimmerBrush: lighter sweep; same-hue transparent stops prevent black fringing -->
          <LinearGradientBrush x:Key="SkeletonShimmerBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#00DEDEDE" Offset="0"/>
            <GradientStop Color="#F8F8F8"   Offset="0.5"/>
            <GradientStop Color="#00DEDEDE" Offset="1"/>
          </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="SystemAccentColor">#8B52FF</Color>
          <Color x:Key="SystemAccentColorDark1">#7A44E8</Color>
          <Color x:Key="SystemAccentColorDark2">#6738CC</Color>
          <Color x:Key="SystemAccentColorDark3">#552EAD</Color>
          <Color x:Key="SystemAccentColorLight1">#9B69FF</Color>
          <Color x:Key="SystemAccentColorLight2">#AD83FF</Color>
          <Color x:Key="SystemAccentColorLight3">#C09DFF</Color>
          <CornerRadius x:Key="ControlCornerRadius">20</CornerRadius>
          <FontFamily x:Key="AppDefaultFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
          <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
          <FontFamily x:Key="ControlContentThemeFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
          <FontFamily x:Key="TextControlThemeFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
          <Color x:Key="SkeletonBaseColor">#252525</Color>
          <SolidColorBrush x:Key="SkeletonBaseBrush" Color="#252525"/>
          <LinearGradientBrush x:Key="SkeletonShimmerBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#00252525" Offset="0"/>
            <GradientStop Color="#3D3D3D"   Offset="0.5"/>
            <GradientStop Color="#00252525" Offset="1"/>
          </LinearGradientBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- ── Global Typography & Shape ── -->
      <FontFamily x:Key="AppDefaultFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
      <FontFamily x:Key="AppSignatureFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>

      <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppDefaultFontFamily}"/>
      </Style>

      <!-- ── Modern Search Styles ── -->
      <Style x:Key="ModernSearchTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="IsDeleteButtonVisible" Value="False"/>
        <Setter Property="Resources">
          <ResourceDictionary>
            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
          </ResourceDictionary>
        </Setter>
      </Style>

      <Style x:Key="ModernSearchAutoSuggestBoxStyle" TargetType="AutoSuggestBox" BasedOn="{StaticResource {x:Type AutoSuggestBox}}">
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Padding" Value="16,12,48,12"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Resources">
          <ResourceDictionary>
            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
            <Thickness x:Key="AutoSuggestBoxBorderThemeThickness">0</Thickness>
          </ResourceDictionary>
        </Setter>
      </Style>

      <!-- Global Implicit Styles for consistent focus effect -->
      <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AppDefaultFontFamily}"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,12"/>
        <Setter Property="Resources">
          <ResourceDictionary>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#8B52FF"/>
            <!-- Seamless transparency for internal parts -->
            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
          </ResourceDictionary>
        </Setter>
      </Style>

      <Style TargetType="AutoSuggestBox">
        <Setter Property="FontFamily" Value="{StaticResource AppDefaultFontFamily}"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,12,48,12"/>
        <Setter Property="Resources">
          <ResourceDictionary>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#8B52FF"/>
          </ResourceDictionary>
        </Setter>
      </Style>

      <Style TargetType="controls:DecimalTextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>
      <Style TargetType="controls:NumericTextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>

      <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource AppDefaultFontFamily}"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,12"/>
        <Setter Property="Resources">
          <ResourceDictionary>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#8B52FF"/>
            <!-- Seamless transparency for internal parts -->
            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
          </ResourceDictionary>
        </Setter>
      </Style>

      <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource AppDefaultFontFamily}"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,12"/>
        <Setter Property="Resources">
          <ResourceDictionary>
            <Thickness x:Key="ComboBoxBorderThemeThicknessFocused">1</Thickness>
            <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#8B52FF"/>
          </ResourceDictionary>
        </Setter>
      </Style>

      <!-- ── Custom Button Styles ── -->
      <Style x:Key="ColorPreservingButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <ContentPresenter x:Name="ContentPresenter"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                CornerRadius="{TemplateBinding CornerRadius}"/>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="DefaultContentDialogStyle" TargetType="ContentDialog">
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
        <Setter Property="Background" Value="{ThemeResource ContentDialogBackground}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource ContentDialogBorderBrush}"/>
      </Style>

      <!-- ── Pagination Button Styles (Synced with Orders Management) ── -->
      <Style x:Key="PageBtn" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
      </Style>

      <Style x:Key="PageBtnActive" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PurpleBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderThickness" Value="0"/>
      </Style>

      <conv:OrderIdConverter x:Key="OrderIdConverter"/>
    </ResourceDictionary>
  </Application.Resources>

</Application>
