<Application x:Class="MyShop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MyShop"
             xmlns:conv="using:MyShop.Converters">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- ── Branding Colors ── -->
      <Color x:Key="AppAccentColor">#8B52FF</Color>
      <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
      <SolidColorBrush x:Key="AppAccentBrushLow" Color="{StaticResource AppAccentColor}" Opacity="0.12" />
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <Color x:Key="SystemAccentColor">#8B52FF</Color>
          <Color x:Key="SystemAccentColorDark1">#7A44E8</Color>
          <Color x:Key="SystemAccentColorDark2">#6738CC</Color>
          <Color x:Key="SystemAccentColorDark3">#552EAD</Color>
          <Color x:Key="SystemAccentColorLight1">#9B69FF</Color>
          <Color x:Key="SystemAccentColorLight2">#AD83FF</Color>
          <Color x:Key="SystemAccentColorLight3">#C09DFF</Color>
          <CornerRadius x:Key="ControlCornerRadius">20</CornerRadius>
          <FontFamily x:Key="AppDefaultFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
          <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
          <FontFamily x:Key="ControlContentThemeFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
          <FontFamily x:Key="TextControlThemeFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="SystemAccentColor">#8B52FF</Color>
          <Color x:Key="SystemAccentColorDark1">#7A44E8</Color>
          <Color x:Key="SystemAccentColorDark2">#6738CC</Color>
          <Color x:Key="SystemAccentColorDark3">#552EAD</Color>
          <Color x:Key="SystemAccentColorLight1">#9B69FF</Color>
          <Color x:Key="SystemAccentColorLight2">#AD83FF</Color>
          <Color x:Key="SystemAccentColorLight3">#C09DFF</Color>
          <CornerRadius x:Key="ControlCornerRadius">20</CornerRadius>
          <FontFamily x:Key="AppDefaultFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
          <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
          <FontFamily x:Key="ControlContentThemeFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
          <FontFamily x:Key="TextControlThemeFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="SystemAccentColor">#8B52FF</Color>
          <Color x:Key="SystemAccentColorDark1">#7A44E8</Color>
          <Color x:Key="SystemAccentColorDark2">#6738CC</Color>
          <Color x:Key="SystemAccentColorDark3">#552EAD</Color>
          <Color x:Key="SystemAccentColorLight1">#9B69FF</Color>
          <Color x:Key="SystemAccentColorLight2">#AD83FF</Color>
          <Color x:Key="SystemAccentColorLight3">#C09DFF</Color>
          <CornerRadius x:Key="ControlCornerRadius">20</CornerRadius>
          <FontFamily x:Key="AppDefaultFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
          <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
          <FontFamily x:Key="ControlContentThemeFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
          <FontFamily x:Key="TextControlThemeFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- ── Global Typography & Shape ── -->
      <FontFamily x:Key="AppDefaultFontFamily">ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans</FontFamily>
      <FontFamily x:Key="AppSignatureFontFamily">ms-appx:///Assets/Momo_Signature/MomoSignature-Regular.ttf#MomoSignature-Regular</FontFamily>

      <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppDefaultFontFamily}"/>
      </Style>

      <!-- ── Value Converters ── -->
      <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
      <conv:NullToBoolConverter x:Key="NullToBoolConverter"/>
      <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
      <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
      <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
      <conv:BoolToForegroundConverter x:Key="BoolToForegroundConverter"/>
      <conv:HexToBrushConverter x:Key="HexToBrushConverter"/>
      <conv:StringToBoolConverter x:Key="StringToBoolConverter"/>
      <conv:CurrencyFormatter x:Key="CurrencyFormatter"/>
      <conv:PercentageFormatter x:Key="PercentageFormatter"/>
      <conv:DateFormatter x:Key="DateFormatter"/>
      <conv:OrderStatusToBrushConverter x:Key="OrderStatusToBrushConverter"/>
      <conv:OrderStatusToForegroundConverter x:Key="OrderStatusToForegroundConverter"/>
      <conv:PaymentStatusToBrushConverter x:Key="PaymentStatusToBrushConverter"/>
      <conv:CurrencyConverter x:Key="CurrencyConverter"/>
      <conv:DateTimeOffsetConverter x:Key="DateTimeOffsetConverter"/>
      <conv:LineTotalConverter x:Key="LineTotalConverter"/>
      <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
      <conv:CountToVisibilityInverseConverter x:Key="CountToVisibilityInverseConverter"/>
      <conv:OrderIdConverter x:Key="OrderIdConverter"/>
      <conv:CurrencyFormatter x:Key="CurrencyFormatter"/>
      <conv:PercentageFormatter x:Key="PercentageFormatter"/>
      <conv:DateFormatter x:Key="DateFormatter"/>

    </ResourceDictionary>
  </Application.Resources>

</Application>
