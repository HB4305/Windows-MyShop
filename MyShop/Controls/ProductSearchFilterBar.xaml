<UserControl x:Class="MyShop.Controls.ProductSearchFilterBar"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid ColumnSpacing="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Category ComboBox -->
    <ComboBox x:Name="CategoryComboBox"
              Grid.Column="0"
              ItemsSource="{Binding CategoryItemsSource, ElementName=Root}"
              SelectedItem="{Binding SelectedCategory, ElementName=Root, Mode=TwoWay}"
              SelectionChanged="CategoryComboBox_SelectionChanged"
              PlaceholderText="{Binding CategoryPlaceholderText, ElementName=Root}"
              Height="48"
              CornerRadius="24"
              BorderThickness="1"
              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
              Background="{ThemeResource ControlFillColorDefaultBrush}"
              HorizontalAlignment="Stretch"
              FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans">
    </ComboBox>

    <Border x:Name="SearchWrapper"
            Grid.Column="1"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            BorderThickness="1"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            CornerRadius="24"
            Height="48"
            VerticalAlignment="Center">
      <Grid>
        <AutoSuggestBox x:Name="SearchAutoSuggestBox"
                        PlaceholderText="{Binding SearchPlaceholderText, ElementName=Root}"
                        Text="{Binding SearchText, ElementName=Root, Mode=TwoWay}"
                        ItemsSource="{Binding SearchItemsSource, ElementName=Root}"
                        TextChanged="SearchAutoSuggestBox_TextChanged"
                        SuggestionChosen="SearchAutoSuggestBox_SuggestionChosen"
                        QuerySubmitted="SearchAutoSuggestBox_QuerySubmitted"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="16,0,48,0"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        GotFocus="SearchAutoSuggestBox_GotFocus"
                        LostFocus="SearchAutoSuggestBox_LostFocus"
                        FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans">
          <AutoSuggestBox.Resources>
            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
          </AutoSuggestBox.Resources>
        </AutoSuggestBox>
  
        <Button Command="{Binding SearchCommand, ElementName=Root}"
                Click="SearchButton_Click"
                Content="&#xE721;" 
                FontFamily="Segoe MDL2 Assets"
                FontSize="16"
                Background="Transparent" 
                BorderThickness="0" 
                Padding="12"
                Margin="0,0,4,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{StaticResource AppPurpleBrush}" 
                Style="{StaticResource ColorPreservingButtonStyle}"
                ToolTipService.ToolTip="Search"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
