<UserControl x:Class="MyShop.Controls.ProductSearchFilterBar"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid ColumnSpacing="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Category ComboBox -->
    <ComboBox x:Name="CategoryComboBox"
              Grid.Column="0"
              ItemsSource="{Binding CategoryItemsSource, ElementName=Root}"
              SelectedItem="{Binding SelectedCategory, ElementName=Root, Mode=TwoWay}"
              SelectionChanged="CategoryComboBox_SelectionChanged"
              PlaceholderText="{Binding CategoryPlaceholderText, ElementName=Root}"
              Height="48"
              CornerRadius="24"
              BorderThickness="1"
              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
              Background="{ThemeResource ControlFillColorDefaultBrush}"
              HorizontalAlignment="Stretch"
              FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans">
    </ComboBox>

    <Border x:Name="SearchWrapper"
            Grid.Column="1"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            BorderThickness="1"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            CornerRadius="24"
            Height="48"
            VerticalAlignment="Center">
        <AutoSuggestBox x:Name="SearchAutoSuggestBox"
                        PlaceholderText="{Binding SearchPlaceholderText, ElementName=Root}"
                        Text="{Binding SearchText, ElementName=Root, Mode=TwoWay}"
                        ItemsSource="{Binding SearchItemsSource, ElementName=Root}"
                        TextChanged="SearchAutoSuggestBox_TextChanged"
                        SuggestionChosen="SearchAutoSuggestBox_SuggestionChosen"
                        QuerySubmitted="SearchAutoSuggestBox_QuerySubmitted"
                        QueryIcon="Find"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="16,0,12,0"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        GotFocus="SearchAutoSuggestBox_GotFocus"
                        LostFocus="SearchAutoSuggestBox_LostFocus"
                        FontFamily="ms-appx:///Assets/Fonts/MomoTrustSans-VariableFont_wght.ttf#Momo Trust Sans">
          <AutoSuggestBox.Resources>
            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
            <!-- Style the internal query button -->
            <Style TargetType="Button" x:Key="AutoSuggestBoxQueryButtonStyle">
                <Setter Property="Foreground" Value="{StaticResource AppPurpleBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Style" Value="{StaticResource ColorPreservingButtonStyle}"/>
            </Style>
            <!-- Ensure clear button is styled consistently -->
            <Style TargetType="Button" x:Key="AutoSuggestBoxDeleteButtonStyle">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="Style" Value="{StaticResource ColorPreservingButtonStyle}"/>
            </Style>
          </AutoSuggestBox.Resources>
        </AutoSuggestBox>
    </Border>
  </Grid>
</UserControl>
