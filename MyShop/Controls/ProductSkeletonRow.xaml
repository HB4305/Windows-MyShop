<UserControl x:Class="MyShop.Controls.ProductSkeletonRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MyShop.Controls">

    <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,10">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="168"/>
                <ColumnDefinition Width="118"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <controls:ShimmerLoadingControl Width="44" Height="44" CornerRadius="8" HorizontalAlignment="Left"/>
                <controls:ShimmerLoadingControl Width="140" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            </StackPanel>

            <controls:ShimmerLoadingControl Grid.Column="1" Width="80" Height="14" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            
            <controls:ShimmerLoadingControl Grid.Column="2" Width="60" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>

            <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="6">
                <controls:ShimmerLoadingControl Width="140" Height="6" CornerRadius="3" HorizontalAlignment="Left"/>
                <controls:ShimmerLoadingControl Width="80" Height="12" HorizontalAlignment="Left"/>
            </StackPanel>

            <controls:ShimmerLoadingControl Grid.Column="4" Width="70" Height="24" CornerRadius="12" VerticalAlignment="Center" HorizontalAlignment="Left"/>

            <controls:ShimmerLoadingControl Grid.Column="5" Width="16" Height="16" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
