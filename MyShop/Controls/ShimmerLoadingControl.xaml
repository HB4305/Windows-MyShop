<UserControl x:Class="MyShop.Controls.ShimmerLoadingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             SizeChanged="OnSizeChanged"
             Unloaded="OnUnloaded">
    <!--
        RootGrid is clipped in code-behind (RectangleGeometry) so ShimmerRect
        can never overflow outside the control bounds regardless of its width.
    -->
    <Grid x:Name="RootGrid"
          CornerRadius="{x:Bind CornerRadius, Mode=OneWay}"
          Background="{ThemeResource SkeletonBaseBrush}">
        <Rectangle x:Name="ShimmerRect"
                   Fill="{ThemeResource SkeletonShimmerBrush}"
                   VerticalAlignment="Stretch">
            <Rectangle.RenderTransform>
                <TranslateTransform x:Name="ShimmerTransform"/>
            </Rectangle.RenderTransform>
        </Rectangle>
    </Grid>
</UserControl>
