<UserControl x:Class="MyShop.Controls.ShimmerLoadingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid CornerRadius="{x:Bind CornerRadius, Mode=OneWay}"
          Background="{ThemeResource SkeletonBaseBrush}">
        <!-- Use a nested Grid to ensure clipping of the moving shimmer -->
        <Grid Padding="0">
            <Rectangle x:Name="ShimmerRect" 
                       Fill="{ThemeResource SkeletonShimmerBrush}"
                       Width="800" 
                       HorizontalAlignment="Left"
                       VerticalAlignment="Stretch">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="ShimmerTransform"/>
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>
    </Grid>
</UserControl>
