<UserControl x:Class="MyShop.Controls.CategorySkeletonRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MyShop.Controls">

    <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,12">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>

            <controls:ShimmerLoadingControl Grid.Column="0" Width="30" Height="14" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <controls:ShimmerLoadingControl Grid.Column="1" Width="200" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <controls:ShimmerLoadingControl Grid.Column="2" Width="100" Height="14" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <controls:ShimmerLoadingControl Grid.Column="3" Width="60" Height="14" VerticalAlignment="Center" HorizontalAlignment="Left"/>

            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <controls:ShimmerLoadingControl Width="24" Height="24" CornerRadius="12"/>
                <controls:ShimmerLoadingControl Width="24" Height="24" CornerRadius="12"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
