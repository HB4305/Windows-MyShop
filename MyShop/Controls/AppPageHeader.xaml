<UserControl x:Class="MyShop.Controls.AppPageHeader"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="4">
    <TextBlock Text="{Binding Title, ElementName=Root}"
               FontFamily="{Binding TitleFontFamily, ElementName=Root}"
               FontSize="{Binding TitleFontSize, ElementName=Root}"
               FontWeight="Bold"
               Foreground="{ThemeResource TextFillColorPrimary}"/>
    <TextBlock Text="{Binding Subtitle, ElementName=Root}"
               FontFamily="{Binding SubtitleFontFamily, ElementName=Root}"
               FontSize="{Binding SubtitleFontSize, ElementName=Root}"
               Foreground="{ThemeResource TextFillColorSecondary}"
               Visibility="{Binding SubtitleVisibility, ElementName=Root}"/>
  </StackPanel>
</UserControl>