<UserControl x:Class="MyShop.Controls.AppPageHeader"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0" Spacing="4">
      <TextBlock Text="{Binding Title, ElementName=Root}"
                 FontFamily="{Binding TitleFontFamily, ElementName=Root}"
                 FontSize="{Binding TitleFontSize, ElementName=Root}"
                 FontWeight="Bold"
                 Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
      <TextBlock Text="{Binding Subtitle, ElementName=Root}"
                 FontFamily="{Binding SubtitleFontFamily, ElementName=Root}"
                 FontSize="{Binding SubtitleFontSize, ElementName=Root}"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 Visibility="{Binding SubtitleVisibility, ElementName=Root}"/>
    </StackPanel>

    <ContentPresenter Grid.Column="1" 
                      Content="{Binding Actions, ElementName=Root}"
                      VerticalAlignment="Center"/>
  </Grid>
</UserControl>
