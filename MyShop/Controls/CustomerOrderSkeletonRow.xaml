<UserControl x:Class="MyShop.Controls.CustomerOrderSkeletonRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MyShop.Controls">

    <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,14">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>

            <!-- ID -->
            <controls:ShimmerLoadingControl Grid.Column="0" Width="40" Height="14" HorizontalAlignment="Center"/>
            
            <!-- Customer -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                <controls:ShimmerLoadingControl Width="32" Height="32" CornerRadius="16"/>
                <controls:ShimmerLoadingControl Width="100" Height="14" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Phone -->
            <controls:ShimmerLoadingControl Grid.Column="2" Width="90" Height="14" HorizontalAlignment="Center"/>

            <!-- Staff -->
            <controls:ShimmerLoadingControl Grid.Column="3" Width="110" Height="14" HorizontalAlignment="Center"/>

            <!-- Date -->
            <controls:ShimmerLoadingControl Grid.Column="4" Width="100" Height="14" HorizontalAlignment="Center"/>

            <!-- Order Type -->
            <controls:ShimmerLoadingControl Grid.Column="5" Width="80" Height="14" HorizontalAlignment="Center"/>

            <!-- Status -->
            <controls:ShimmerLoadingControl Grid.Column="6" Width="70" Height="22" CornerRadius="11" HorizontalAlignment="Center"/>

            <!-- Payment Status -->
            <controls:ShimmerLoadingControl Grid.Column="7" Width="80" Height="22" CornerRadius="11" HorizontalAlignment="Center"/>

            <!-- Payment Method -->
            <controls:ShimmerLoadingControl Grid.Column="8" Width="90" Height="14" HorizontalAlignment="Center"/>

            <!-- Total -->
            <controls:ShimmerLoadingControl Grid.Column="9" Width="70" Height="16" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
