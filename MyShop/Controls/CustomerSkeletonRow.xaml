<UserControl x:Class="MyShop.Controls.CustomerSkeletonRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MyShop.Controls">

    <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,10">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="150"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <controls:ShimmerLoadingControl Grid.Column="0" Width="120" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="4"/>
            <controls:ShimmerLoadingControl Grid.Column="1" Width="100" Height="14" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <controls:ShimmerLoadingControl Grid.Column="2" Width="150" Height="14" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <controls:ShimmerLoadingControl Grid.Column="3" Width="80" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <controls:ShimmerLoadingControl Grid.Column="4" Width="40" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"/>

            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <controls:ShimmerLoadingControl Width="24" Height="24" CornerRadius="12"/>
                <controls:ShimmerLoadingControl Width="24" Height="24" CornerRadius="12"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
