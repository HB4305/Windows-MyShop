<UserControl x:Class="MyShop.Controls.ShiftLogSkeletonRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MyShop.Controls">

    <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,10">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <controls:ShimmerLoadingControl Width="30" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <controls:ShimmerLoadingControl Grid.Column="1" Width="160" Height="14" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <controls:ShimmerLoadingControl Grid.Column="2" Width="110" Height="14" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <controls:ShimmerLoadingControl Grid.Column="3" Width="110" Height="14" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <controls:ShimmerLoadingControl Grid.Column="4" Width="90" Height="16" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <controls:ShimmerLoadingControl Grid.Column="5" Width="90" Height="14" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <controls:ShimmerLoadingControl Grid.Column="6" Width="90" Height="14" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <controls:ShimmerLoadingControl Grid.Column="7" Width="60" Height="14" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <controls:ShimmerLoadingControl Grid.Column="8" Width="100" Height="12" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0,0,0"/>
        </Grid>
    </Border>
</UserControl>
